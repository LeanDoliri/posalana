---
export interface Props {
    user: {
        username: string;
        display_name?: string | null;
        avatar_url?: string | null;
    };
    size?: "sm" | "md" | "lg" | "xl";
    border?: boolean;
}

const { user, size = "md", border = false } = Astro.props;

const sizeClasses = {
    sm: "w-6 h-6 text-mini",
    md: "w-10 h-10 text-sm",
    lg: "w-16 h-16 text-xl",
    xl: "w-32 h-32 text-4xl"
};

const hasAvatar = user.avatar_url && user.avatar_url !== 'null';
const name = user.display_name || user.username;
const initial = name ? name.charAt(0).toUpperCase() : '?';
---

<!-- Avatar: matiz cyan al 15 % con la inicial en gris oscuro (Permitido del perfil) -->
<div class={`${sizeClasses[size]} shrink-0 rounded-lutvia-pildora bg-lutvia-cyan/15 flex items-center justify-center font-bold text-lutvia-oscuro overflow-hidden hover-pulse-glow ${border ? 'border-2 border-lutvia-blanco' : ''}`}>
    {hasAvatar ? (
        <img src={user.avatar_url as string} alt={name} class="w-full h-full object-cover" referrerpolicy="no-referrer" />
    ) : (
        <span aria-hidden="true">{initial}</span>
    )}
</div>
