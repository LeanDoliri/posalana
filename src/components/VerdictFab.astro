---
// Burbuja flotante (estilo WhatsApp) para que el admin publique el veredicto
// final del día en Discord desde cualquier página.
---

<div id="verdict-fab" class="fixed bottom-5 right-5 md:bottom-8 md:right-8 z-30 flex flex-col items-end gap-3">
    <!-- Panel de confirmación: blanco con borde oscuro, sin sombra (puede quedar sobre una tarjeta blanca) -->
    <div
        id="verdict-fab-panel"
        class="hidden w-72 bg-lutvia-blanco border-2 border-lutvia-oscuro rounded-lutvia-radio p-5 animate-in fade-in zoom-in-95"
        role="dialog"
        aria-labelledby="verdict-fab-title"
    >
        <p id="verdict-fab-title" class="font-black text-lutvia-oscuro flex items-center gap-2">
            <i class="fa-solid fa-scroll" aria-hidden="true"></i> Veredicto final
        </p>
        <p class="text-xs text-lutvia-texto-suave leading-relaxed mt-1.5">
            Publica en Discord quién pone, saca y lava hoy, con la cantidad de jugadores que tiraron.
        </p>
        <p id="verdict-fab-status" class="hidden text-xs font-semibold mt-3" role="status"></p>
        <div class="flex gap-2 mt-4">
            <button
                type="button"
                data-verdict-close
                class="boton boton-secundario flex-1 text-sm px-3"
            >
                Cancelar
            </button>
            <button
                type="button"
                id="verdict-fab-publish"
                class="boton boton-principal flex-1 text-sm px-3"
            >
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Publicar
            </button>
        </div>
    </div>

    <!-- Burbuja: botón de ícono (círculo oscuro con ícono blanco; amarillo al pasar el mouse) -->
    <button
        type="button"
        id="verdict-fab-toggle"
        aria-label="Publicar veredicto final en Discord"
        aria-expanded="false"
        aria-controls="verdict-fab-panel"
        title="Publicar veredicto final"
        class="boton-icono w-14 h-14 md:w-16 md:h-16 text-xl md:text-2xl"
    >
        <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
    </button>
</div>

<script>
    // El ClientRouter reemplaza el <body> en cada navegación, así que
    // delegamos los eventos en el document una sola vez.
    if (!(window as any).__verdictFabInit) {
        (window as any).__verdictFabInit = true;

        const getEls = () => ({
            panel: document.getElementById('verdict-fab-panel'),
            toggle: document.getElementById('verdict-fab-toggle'),
            publish: document.getElementById('verdict-fab-publish') as HTMLButtonElement | null,
            status: document.getElementById('verdict-fab-status'),
        });

        const setOpen = (open: boolean) => {
            const { panel, toggle, status } = getEls();
            if (!panel || !toggle) return;
            panel.classList.toggle('hidden', !open);
            toggle.setAttribute('aria-expanded', String(open));
            if (open && status) {
                status.className = 'hidden text-xs font-semibold mt-3';
                status.textContent = '';
            }
        };

        // El mensaje va siempre en gris oscuro; el ícono marca el resultado (el rosa, solo en el ícono de error)
        const setStatus = (text: string, tone: 'muted' | 'ok' | 'error') => {
            const { status } = getEls();
            if (!status) return;
            const icon = tone === 'ok' ? 'fa-circle-check' : tone === 'error' ? 'fa-triangle-exclamation text-lutvia-rosa' : 'fa-spinner fa-spin';
            const color = tone === 'muted' ? 'text-lutvia-texto-suave' : 'text-lutvia-oscuro';
            status.className = `flex items-start gap-1.5 text-xs font-semibold mt-3 ${color}`;
            status.innerHTML = `<i class="fa-solid ${icon} mt-0.5" aria-hidden="true"></i>`;
            status.append(document.createTextNode(text));
        };

        const publishVerdict = async () => {
            const { publish } = getEls();
            if (publish) publish.disabled = true;
            setStatus('Enviando veredicto...', 'muted');

            try {
                const res = await fetch('/api/admin/publish-verdict', { method: 'POST' });
                const data = await res.json();
                if (res.ok && data.success) {
                    setStatus('¡Veredicto publicado en Discord!', 'ok');
                } else {
                    setStatus(`Error: ${data.error || 'No se pudo publicar'}`, 'error');
                }
            } catch (err: any) {
                setStatus(`Error: ${err.message || 'Error de conexión'}`, 'error');
            } finally {
                if (publish) publish.disabled = false;
            }
        };

        document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const fab = document.getElementById('verdict-fab');
            if (!fab) return;

            if (target.closest('#verdict-fab-toggle')) {
                const { panel } = getEls();
                setOpen(panel?.classList.contains('hidden') ?? false);
            } else if (target.closest('[data-verdict-close]')) {
                setOpen(false);
            } else if (target.closest('#verdict-fab-publish')) {
                publishVerdict();
            } else if (!fab.contains(target)) {
                setOpen(false);
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setOpen(false);
        });
    }
</script>
