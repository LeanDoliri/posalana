---
import db from "../db/index.js";
import UserAvatar from "./UserAvatar.astro";
import { formatDate } from "../utils/date.js";

const { user } = Astro.locals;
const currentPath = Astro.url.pathname;

// Calculate days without lomito
const today = new Date();
today.setHours(today.getHours() - 3);
const todayStr = today.toISOString().split('T')[0];

const lastLomitoRes = await db.execute(`
	SELECT r1.date
	FROM roll r1
	JOIN roll r2 ON r1.date = r2.date AND r1.id != r2.id
		AND r1.die1 = r2.die1 AND r1.die2 = r2.die2
		AND r1.die3 = r2.die3 AND r1.die4 = r2.die4
	ORDER BY r1.date DESC
	LIMIT 1
`);

const autoLomitoDate = lastLomitoRes.rows.length > 0 ? lastLomitoRes.rows[0].date as string : null;

const settingsRes = await db.execute("SELECT value FROM settings WHERE key = 'last_lomito_date'");
const manualLomitoDate = settingsRes.rows.length > 0 ? settingsRes.rows[0].value as string : null;

let lastLomitoDate = manualLomitoDate ? manualLomitoDate : autoLomitoDate;

let daysSinceLomito: number | null = null;
let lomitoTooltip = "Nunca hubo un lomito aún 😢";

if (lastLomitoDate) {
	const last = new Date(lastLomitoDate + "T12:00:00");
	const now = new Date(todayStr + "T12:00:00");
	daysSinceLomito = Math.floor((now.getTime() - last.getTime()) / (1000 * 60 * 60 * 24));
	lomitoTooltip = `Último lomito: ${formatDate(lastLomitoDate)}`;
}
---

<!-- Cabecera fija: blanca con borde inferior, sin sombra -->
<header class="sticky top-0 z-50 bg-lutvia-blanco border-b border-lutvia-oscuro-16">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center">
        <!-- Wordmark y contador de Lomito -->
        <div class="flex items-center gap-3">
            <!-- Wordmark por sílabas (Permitido del perfil: solo como logo) -->
            <h1 class="text-2xl font-black tracking-tighter">
                <a href="/" class="flex" aria-label="POSALANA, ir al inicio">
                    <span class="text-lutvia-rosa" aria-hidden="true">PO</span>
                    <span class="text-lutvia-cyan" aria-hidden="true">SA</span>
                    <span class="text-lutvia-violeta" aria-hidden="true">LA</span>
                    <span class="text-lutvia-oscuro" aria-hidden="true">NA</span>
                </a>
            </h1>

            <div class="relative group hidden sm:block">
                <!-- Chip de Lomito: matiz violeta al 15 % con texto oscuro -->
                <span data-lomito-badge tabindex="0" class="etiqueta bg-lutvia-violeta/15 cursor-default select-none" aria-describedby="lomito-tooltip">
                    <span aria-hidden="true">🥪</span> {daysSinceLomito !== null ? daysSinceLomito : "∞"} {daysSinceLomito === 1 ? 'día' : 'días'} sin lomito
                    <span class="hidden sin-hover:inline">({lomitoTooltip})</span>
                </span>
                <div id="lomito-tooltip" role="tooltip" class="absolute left-1/2 -translate-x-1/2 top-full mt-2 bg-lutvia-oscuro text-lutvia-blanco text-mini font-bold px-3 py-2 rounded-lutvia-radio-chico whitespace-nowrap opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 sin-hover:hidden transition-opacity pointer-events-none z-50">
                    {lomitoTooltip}
                </div>
            </div>
        </div>

        <!-- Navegación de escritorio -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-semibold" aria-label="Principal">
            <a href="/" class="nav-link" aria-current={currentPath === "/" ? "page" : undefined}>Inicio</a>
            <a href="/history" class="nav-link" aria-current={currentPath.startsWith("/history") ? "page" : undefined}>Historial</a>
            <a href="/rules" class="nav-link" aria-current={currentPath.startsWith("/rules") ? "page" : undefined}>Reglas</a>

            {user ? (
                <div class="flex items-center gap-4 pl-4 border-l border-lutvia-oscuro-16">
                    <div class="flex items-center gap-2">
                        <a href="/profile" class="nav-link font-bold flex items-center gap-2" aria-current={currentPath.startsWith("/profile") ? "page" : undefined}>
                            <i class="fa-solid fa-user-circle" aria-hidden="true"></i> {user.display_name || user.username}
                        </a>
                        {user.role === 'admin' && (
                            <a href="/admin" class="etiqueta bg-lutvia-rosa/15 uppercase tracking-wider hover:bg-lutvia-rosa/20 transition-colors">Admin</a>
                        )}
                    </div>
                    <form method="post" action="/api/logout">
                        <button class="boton-icono" aria-label="Cerrar sesión" title="Cerrar sesión"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i></button>
                    </form>
                </div>
            ) : (
                <a href="/login" class="boton boton-secundario text-sm">Iniciar sesión</a>
            )}
        </nav>

        <!-- Botón del menú en el teléfono -->
        <button id="mobile-menu-btn" class="md:hidden boton-icono" aria-label="Abrir menú" title="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
    </div>

    <!-- Contador de Lomito en el teléfono -->
    <div class="sm:hidden px-4 pb-3 border-t border-lutvia-oscuro-16 flex justify-center">
        <span data-lomito-badge class="etiqueta bg-lutvia-violeta/15 cursor-default select-none mt-2">
            <span aria-hidden="true">🥪</span> {daysSinceLomito !== null ? daysSinceLomito : "∞"} {daysSinceLomito === 1 ? 'día' : 'días'} sin lomito ({lomitoTooltip})
        </span>
    </div>
</header>

<!-- Menú del teléfono -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-lutvia-blanco flex-col md:hidden pt-20 hidden">
    <nav class="flex flex-col gap-2 p-6 text-xl font-bold" aria-label="Principal">
        <a href="/" class="mobile-link p-4 rounded-lutvia-radio-chico text-lutvia-oscuro hover:bg-lutvia-gris transition-colors"><i class="fa-solid fa-home fa-fw mr-3" aria-hidden="true"></i>Inicio</a>
        <a href="/history" class="mobile-link p-4 rounded-lutvia-radio-chico text-lutvia-oscuro hover:bg-lutvia-gris transition-colors"><i class="fa-solid fa-clock-rotate-left fa-fw mr-3" aria-hidden="true"></i>Historial</a>
        <a href="/rules" class="mobile-link p-4 rounded-lutvia-radio-chico text-lutvia-oscuro hover:bg-lutvia-gris transition-colors"><i class="fa-solid fa-book fa-fw mr-3" aria-hidden="true"></i>Reglas</a>

        {user ? (
            <div class="pt-6 mt-4 border-t border-lutvia-oscuro-16">
                <div class="p-4 flex items-center justify-between gap-3">
                    <a href="/profile" class="mobile-link flex items-center gap-3 rounded-lutvia-radio-chico">
                        <UserAvatar user={user as any} size="sm" />
                        <div>
                            <p class="text-sm font-normal text-lutvia-texto-suave">Editar perfil</p>
                            <p class="text-lutvia-oscuro font-bold flex items-center gap-1.5">
                                {user.display_name || user.username} <i class="fa-solid fa-pen-to-square text-xs text-lutvia-texto-suave" aria-hidden="true"></i>
                            </p>
                        </div>
                    </a>
                    {user.role === 'admin' && (
                        <a href="/admin" class="mobile-link etiqueta bg-lutvia-rosa/15 uppercase tracking-wider">Admin</a>
                    )}
                </div>
                <form method="post" action="/api/logout" class="mt-2 px-4">
                    <button class="boton boton-secundario w-full"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Cerrar sesión</button>
                </form>
            </div>
        ) : (
            <div class="pt-6 mt-4 border-t border-lutvia-oscuro-16">
                <a href="/login" class="mobile-link boton boton-secundario w-full"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Iniciar sesión</a>
            </div>
        )}
    </nav>
</div>

<!-- Easter egg: muchos clicks en el badge de días sin lomito desatan una lluvia de lomitos -->
<script>
    if (!(window as any).__lomitoRainInit) {
        (window as any).__lomitoRainInit = true;

        const CLICKS_NEEDED = 7;
        const WINDOW_MS = 3000;
        let clicks: number[] = [];
        let raining = false;

        const makeItRain = () => {
            const count = 70;
            const perFrame = 10;

            const layer = document.createElement('div');
            layer.setAttribute('aria-hidden', 'true');
            layer.style.cssText = 'position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:9998;';
            document.documentElement.append(layer);

            const animations: Animation[] = [];
            let created = 0;

            // Creamos los lomitos en tandas, una por frame, para no trabar el hilo principal
            const spawnBatch = () => {
                const batch = Math.min(perFrame, count - created);
                for (let i = 0; i < batch; i++) {
                    const lomito = document.createElement('span');
                    lomito.textContent = '🥪';
                    const size = 22 + Math.random() * 34;
                    lomito.style.cssText = `position:absolute;top:-80px;left:${Math.random() * 100}vw;font-size:${size}px;line-height:1;`;
                    layer.append(lomito);

                    const drift = (Math.random() - 0.5) * 200;
                    const spin = (Math.random() - 0.5) * 720;
                    animations.push(lomito.animate(
                        [
                            { transform: 'translate(0, 0) rotate(0deg)' },
                            { transform: `translate(${drift}px, calc(100vh + 160px)) rotate(${spin}deg)` }
                        ],
                        {
                            duration: 2200 + Math.random() * 2200,
                            delay: Math.random() * 2000,
                            easing: 'cubic-bezier(0.35, 0, 0.8, 0.6)',
                            fill: 'both'
                        }
                    ));
                }
                created += batch;

                if (created < count) {
                    requestAnimationFrame(spawnBatch);
                } else {
                    Promise.all(animations.map(a => a.finished)).finally(() => {
                        layer.remove();
                        raining = false;
                    });
                }
            };

            requestAnimationFrame(spawnBatch);
        };

        document.addEventListener('click', (e) => {
            const badge = (e.target as HTMLElement).closest<HTMLElement>('[data-lomito-badge]');
            if (!badge || raining) return;

            const now = Date.now();
            clicks = clicks.filter(t => now - t < WINDOW_MS);
            clicks.push(now);
            const triggered = clicks.length >= CLICKS_NEEDED;

            // Con movimiento reducido no hay rebote ni lluvia: el easter egg queda apagado
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            // Pequeño "rebote" en cada click, así se siente que algo pasa
            const bounce = badge.animate(
                [{ transform: 'scale(1)' }, { transform: 'scale(1.12) rotate(-3deg)' }, { transform: 'scale(1)' }],
                { duration: 220, easing: 'ease-out' }
            );

            if (triggered) {
                clicks = [];
                raining = true;
                // La lluvia arranca recién cuando termina el rebote, así no compiten por el mismo frame
                bounce.finished.then(makeItRain, makeItRain);
            }
        });
    }
</script>

<!-- Script del menú del teléfono -->
<script>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = btn?.querySelector('i');
        const links = document.querySelectorAll('.mobile-link');

        let isMenuOpen = false;

        function setMenu(open: boolean) {
            isMenuOpen = open;
            menu?.classList.toggle('hidden', !open);
            menu?.classList.toggle('flex', open);
            icon?.classList.toggle('fa-bars', !open);
            icon?.classList.toggle('fa-xmark', open);
            const label = open ? 'Cerrar menú' : 'Abrir menú';
            btn?.setAttribute('aria-label', label);
            btn?.setAttribute('title', label);
            btn?.setAttribute('aria-expanded', String(open));
            document.body.style.overflow = open ? 'hidden' : '';
        }

        btn?.addEventListener('click', () => setMenu(!isMenuOpen));

        links.forEach(link => {
            link.addEventListener('click', () => {
                if (isMenuOpen) setMenu(false);
            });
        });

        // Escape cierra lo que se abre
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isMenuOpen) {
                setMenu(false);
                btn?.focus();
            }
        });
    });
</script>

<style>
    /* Enlaces de la navegación: gris oscuro; al pasar el mouse, subrayado rosa de 2 px.
       La página actual queda subrayada en gris oscuro. */
    .nav-link {
        color: var(--lutvia-oscuro);
        text-decoration-line: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
        transition: text-decoration-color var(--lutvia-transicion);
    }
    .nav-link:hover {
        text-decoration-color: var(--lutvia-rosa);
    }
    .nav-link[aria-current="page"] {
        text-decoration-color: var(--lutvia-oscuro);
    }
    .nav-link[aria-current="page"]:hover {
        text-decoration-color: var(--lutvia-rosa);
    }
</style>
