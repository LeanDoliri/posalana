---
// Pop-up temporal que anuncia el horario nuevo de la tirada. Se monta en el
// inicio solo hasta SCHEDULE_NOTICE_UNTIL (ver utils/schedule.ts) y aparece una
// vez por día: al cerrarlo se guarda la fecha en localStorage.
interface Props {
    start: string;
    end: string;
    dateStr: string;
}

const { start, end, dateStr } = Astro.props;
---

<!-- Fondo lleno en lutvia-gris (sin velo transparente ni desenfoque) y la tarjeta blanca encima -->
<div
    id="schedule-notice"
    data-date={dateStr}
    class="hidden fixed inset-0 z-[90] items-center justify-center bg-lutvia-gris px-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="schedule-notice-title"
>
    <div class="bg-lutvia-blanco rounded-3xl shadow-xl max-w-md w-full p-6 sm:p-8 text-center animate-in zoom-in-95 fade-in">
        <i class="fa-solid fa-clock text-5xl text-lutvia-rosa mb-4" aria-hidden="true"></i>
        <p class="rotulo mb-1">Nueva modalidad</p>
        <h3 id="schedule-notice-title" class="text-2xl font-black text-lutvia-oscuro tracking-tight text-balance">¡Los dados ahora tienen horario!</h3>

        <div class="mt-5 bg-lutvia-gris rounded-lutvia-radio py-4 px-3">
            <p class="rotulo">Horario de tiración</p>
            <p class="text-3xl font-black text-lutvia-oscuro mt-1 tabular-nums">
                {start} <span class="text-lutvia-texto-suave font-normal">a</span> {end}
            </p>
        </div>

        <ul class="mt-5 space-y-2 text-sm text-lutvia-oscuro text-left">
            <li class="flex gap-2"><i class="fa-solid fa-lock fa-fw mt-1 shrink-0" aria-hidden="true"></i><span>Fuera de ese horario la app no deja tirar.</span></li>
            <li class="flex gap-2"><i class="fa-solid fa-bullhorn fa-fw text-lutvia-rosa mt-1 shrink-0" aria-hidden="true"></i><span>A las <strong>{end}</strong> se publica solo el <strong>veredicto final</strong> en Discord.</span></li>
            <li class="flex gap-2"><i class="fa-solid fa-hourglass-end fa-fw text-lutvia-violeta mt-1 shrink-0" aria-hidden="true"></i><span>Si no tiraste antes del cierre, ese día no jugás.</span></li>
        </ul>

        <button
            type="button"
            data-schedule-notice-close
            class="boton boton-principal mt-6 w-full"
        >
            ¡Entendido!
        </button>
        <a href="/rules" data-schedule-notice-close class="enlace inline-block mt-4 text-sm font-semibold">
            Ver las reglas completas
        </a>
    </div>
</div>

<script is:inline>
    (function () {
        const STORAGE_KEY = "posalana-aviso-horario";
        const modal = document.getElementById("schedule-notice");
        if (!modal) return;

        const today = modal.dataset.date;
        let seen = null;
        try { seen = localStorage.getItem(STORAGE_KEY); } catch (e) {}
        if (seen === today) return;

        const close = () => {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            try { localStorage.setItem(STORAGE_KEY, today); } catch (e) {}
            document.removeEventListener("keydown", onKey);
        };
        const onKey = (e) => { if (e.key === "Escape") close(); };

        modal.querySelectorAll("[data-schedule-notice-close]").forEach((el) => el.addEventListener("click", close));
        modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
        document.addEventListener("keydown", onKey);

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.querySelector("button[data-schedule-notice-close]")?.focus();
    })();
</script>
