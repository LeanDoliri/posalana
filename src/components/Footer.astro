---
const currentYear = new Date().getFullYear();
---

<footer class="bg-lutvia-blanco border-t border-lutvia-oscuro-16 mt-auto py-16">
  <div class="max-w-5xl mx-auto px-6 w-full space-y-12">
    <!-- Wordmark por sílabas (Permitido del perfil: solo como logo, en tamaño de título) -->
    <div class="flex flex-col items-center justify-center">
      <p class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter select-none text-center" aria-label="POSALANA">
        <span class="text-lutvia-rosa" aria-hidden="true">PO</span><span class="text-lutvia-cyan" aria-hidden="true">SA</span><span class="text-lutvia-violeta" aria-hidden="true">LA</span><span class="text-lutvia-oscuro" aria-hidden="true">NA</span>
      </p>
      <p class="rotulo mt-4 text-center">
        Pone · Saca · Lava · Nada
      </p>
    </div>

    <!-- Créditos y repositorio -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-8 border-t border-lutvia-oscuro-16 text-xs text-lutvia-texto-suave">
      <p class="text-center sm:text-left">&copy; {currentYear} POSALANA. Todos los derechos reservados.</p>
      <a
        href="https://github.com/LeanDoliri/posalana"
        target="_blank"
        rel="noopener noreferrer"
        class="boton-icono"
        aria-label="Ver el código en GitHub"
        title="Ver el código en GitHub"
      >
        <i class="fa-brands fa-github" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</footer>
