---
export interface Props {
    die1: number;
    die2: number;
    die3: number;
    die4: number;
    isSafe?: boolean;
    size?: "sm" | "md" | "lg" | "xl";
    color?: string;
}

const { die1, die2, die3, die4, isSafe, size = "md", color } = Astro.props;

const diceWords = ['one', 'two', 'three', 'four', 'five', 'six'];

const getDieClass = (val: number) => `fa-solid fa-dice-${diceWords[val - 1]}`;

const sizeClasses = {
    sm: "text-sm gap-1",
    md: "text-base md:text-lg gap-1.5 md:gap-2",
    lg: "text-xl md:text-2xl gap-2 md:gap-3",
    xl: "text-3xl sm:text-4xl md:text-5xl lg:text-6xl gap-3 sm:gap-4 lg:gap-6"
};

// El dado que decide va en color: cyan si te salvás, rosa si te toca tarea, o el color que pase quien lo usa.
// Sin estado, va en gris oscuro. El color nunca es la única señal: la fila siempre dice el estado en texto.
const decisiveClass = color || (isSafe === undefined ? "text-lutvia-oscuro" : (isSafe ? "text-lutvia-cyan" : "text-lutvia-rosa"));
const dice = [die1, die2, die3, die4];
---

<div class={`flex items-center justify-center ${sizeClasses[size]}`} role="img" aria-label={`Dados: ${dice.join(", ")}`}>
    {dice.map((die, i) => (
        <i class={`${getDieClass(die)} ${i === 0 ? decisiveClass : "text-lutvia-texto-suave"} animate-in fade-in zoom-in-95`} aria-hidden="true"></i>
    ))}
</div>
