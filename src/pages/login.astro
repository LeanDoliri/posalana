---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
	return Astro.redirect('/');
}
---

<Layout>
	<div class="min-h-[70vh] flex items-center justify-center animate-in fade-in slide-in-from-bottom-4">
		<div class="w-full max-w-md bg-lutvia-blanco p-10 rounded-3xl shadow-xl">
			<div class="text-center mb-8">
				<div class="inline-flex items-center justify-center w-16 h-16 rounded-lutvia-pildora bg-lutvia-gris text-lutvia-oscuro mb-4" aria-hidden="true">
					<i class="fa-solid fa-user-lock text-2xl"></i>
				</div>
				<h2 class="text-3xl font-black text-lutvia-oscuro tracking-tight">Bienvenido</h2>
				<p class="text-lutvia-texto-suave mt-2 font-medium">Ingresá para probar tu suerte.</p>
			</div>

			<form method="post" action="/api/login" enctype="application/x-www-form-urlencoded" class="space-y-5">
				<div class="space-y-1">
					<label for="login-username" class="block text-sm font-bold">Usuario</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-user"></i>
						</div>
						<input type="text" id="login-username" name="username" autocomplete="username" class="campo pl-10" placeholder="Tu usuario" required />
					</div>
				</div>

				<div class="space-y-1">
					<label for="login-password" class="block text-sm font-bold">Contraseña</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-key"></i>
						</div>
						<input type="password" id="login-password" name="password" autocomplete="current-password" class="campo pl-10" required />
					</div>
				</div>

				<button type="submit" class="boton boton-principal w-full py-3.5 mt-6">
					<i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Entrar al juego
				</button>
			</form>

			<div class="mt-8 pt-6 border-t border-lutvia-oscuro-16 text-center space-y-3">
				<p class="text-sm font-semibold text-lutvia-oscuro">
					¿No tenés cuenta? <a href="/register" class="enlace">Registrate acá</a>
				</p>
				<p class="text-sm font-semibold">
					<a href="/reset" class="enlace">¿Olvidaste tu contraseña?</a>
				</p>
			</div>
		</div>
	</div>
</Layout>
