---
import Layout from "../layouts/Layout.astro";

const { user } = Astro.locals;

if (!user) {
	return Astro.redirect("/login");
}
---

<Layout>
	<div class="max-w-md mx-auto bg-lutvia-blanco p-8 rounded-3xl shadow-xl mt-10 animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
		<h2 class="text-2xl font-bold mb-6 text-center text-lutvia-oscuro">Mi perfil</h2>

		<div class="flex flex-col items-center space-y-6">
			<!-- Cambiar foto: el avatar es un botón y el ícono de cámara queda siempre visible -->
			<button type="button" id="avatarButton" class="relative rounded-lutvia-pildora cursor-pointer" aria-label="Cambiar foto de perfil" title="Cambiar foto de perfil">
				<img
					src={user.avatar_url as string}
					alt=""
					id="avatarPreview"
					class="w-32 h-32 rounded-lutvia-pildora border-4 border-lutvia-gris object-cover bg-lutvia-gris"
				/>
				<span class="absolute bottom-1 right-1 boton-icono w-10 h-10" aria-hidden="true">
					<i class="fa-solid fa-camera"></i>
				</span>
			</button>

			{user.avatar_url && !user.avatar_url.includes('api.dicebear.com') && (
				<button id="removeAvatarBtn" class="boton boton-secundario boton-peligro text-xs px-4 py-1.5">
					<i class="fa-solid fa-trash-can" aria-hidden="true"></i> Quitar foto
				</button>
			)}

			<div class="text-center w-full">
				<p class="text-sm text-lutvia-texto-suave mb-4">{user.role === 'admin' ? 'Administrador' : 'Jugador'} | @{user.username}</p>
                <div class="flex flex-col gap-2 w-full">
                    <label for="nameInput" class="text-sm font-bold text-left">Tu nombre real</label>
                    <input type="text" id="nameInput" value={user.display_name} class="campo" />
                    <button id="saveNameBtn" class="boton boton-principal w-full mt-2">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Guardar nombre
                    </button>
                </div>
			</div>

			<input type="file" id="avatarInput" accept="image/*" class="hidden" />

			<div id="loadingMessage" class="hidden text-lutvia-texto-suave font-semibold text-sm" role="status">
				<i class="fa-solid fa-spinner fa-spin mr-2" aria-hidden="true"></i> Actualizando...
			</div>
			<!-- Error: ícono rosa y mensaje en gris oscuro -->
			<p id="errorMessage" class="hidden text-lutvia-oscuro font-semibold text-sm" role="alert">
				<i class="fa-solid fa-triangle-exclamation text-lutvia-rosa mr-1" aria-hidden="true"></i> <span data-error-text></span>
			</p>
		</div>
	</div>

	<script>
		document.addEventListener('astro:page-load', () => {
			const input = document.getElementById('avatarInput') as HTMLInputElement;
			const preview = document.getElementById('avatarPreview') as HTMLImageElement;
			const loading = document.getElementById('loadingMessage');
			const errorMsg = document.getElementById('errorMessage');
			const saveNameBtn = document.getElementById('saveNameBtn');
			const nameInput = document.getElementById('nameInput') as HTMLInputElement;

			document.getElementById('avatarButton')?.addEventListener('click', () => input?.click());

			async function updateProfile(data: any) {
				loading?.classList.remove('hidden');
				errorMsg?.classList.add('hidden');

				try {
					const response = await fetch('/api/user/update-profile', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(data)
					});

					if (!response.ok) {
						throw new Error(await response.text());
					}
					window.location.reload();
				} catch (err: any) {
					showError(err.message || "Ocurrió un error");
				} finally {
					loading?.classList.add('hidden');
				}
			}

			saveNameBtn?.addEventListener('click', () => {
				const newName = nameInput?.value.trim();
				if (!newName) {
					showError("El nombre no puede estar vacío");
					return;
				}
				updateProfile({ display_name: newName });
			});

			const removeAvatarBtn = document.getElementById('removeAvatarBtn');
			removeAvatarBtn?.addEventListener('click', () => {
				if (confirm("¿Seguro que querés quitar tu foto de perfil? Vas a volver al avatar por defecto.")) {
					updateProfile({ remove_avatar: true });
				}
			});

			input?.addEventListener('change', async (e) => {
				const file = (e.target as HTMLInputElement).files?.[0];
				if (!file) return;

				if (!file.type.startsWith('image/')) {
					showError("Elegí una imagen.");
					return;
				}

				loading?.classList.remove('hidden');
				errorMsg?.classList.add('hidden');

				try {
					const base64Image = await compressImage(file, 256, 256, 0.8);
					if (preview) preview.src = base64Image;
					updateProfile({ avatar: base64Image });
				} catch (err: any) {
					showError(err.message || "Ocurrió un error al subir la imagen");
					loading?.classList.add('hidden');
				}
			});

			function showError(msg: string) {
				if (errorMsg) {
					const text = errorMsg.querySelector('[data-error-text]');
					if (text) text.textContent = msg;
					errorMsg.classList.remove('hidden');
				}
			}
		});

		// Comprime la imagen usando un Canvas antes de enviarla
		function compressImage(file: File, maxWidth: number, maxHeight: number, quality: number): Promise<string> {
			return new Promise((resolve, reject) => {
				const reader = new FileReader();
				reader.readAsDataURL(file);
				reader.onload = (event) => {
					const img = new Image();
					img.src = event.target?.result as string;
					img.onload = () => {
						const canvas = document.createElement('canvas');
						let width = img.width;
						let height = img.height;

						if (width > height) {
							if (width > maxWidth) {
								height = Math.round(height * maxWidth / width);
								width = maxWidth;
							}
						} else {
							if (height > maxHeight) {
								width = Math.round(width * maxHeight / height);
								height = maxHeight;
							}
						}

						canvas.width = width;
						canvas.height = height;

						const ctx = canvas.getContext('2d');
						if (!ctx) {
							reject(new Error("No se pudo obtener el contexto del canvas"));
							return;
						}
						
						ctx.drawImage(img, 0, 0, width, height);
						resolve(canvas.toDataURL('image/jpeg', quality));
					};
					img.onerror = (err) => reject(err);
				};
				reader.onerror = (err) => reject(err);
			});
		}
	</script>
</Layout>
