---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
	return Astro.redirect('/');
}
---

<Layout>
	<div class="min-h-[70vh] flex items-center justify-center animate-in fade-in slide-in-from-bottom-4">
		<div class="w-full max-w-md bg-lutvia-blanco p-10 rounded-3xl shadow-xl">
			<div class="text-center mb-8">
				<div class="inline-flex items-center justify-center w-16 h-16 rounded-lutvia-pildora bg-lutvia-gris text-lutvia-oscuro mb-4" aria-hidden="true">
					<i class="fa-solid fa-user-plus text-2xl"></i>
				</div>
				<h2 class="text-3xl font-black text-lutvia-oscuro tracking-tight">Registro</h2>
				<p class="text-lutvia-texto-suave mt-2 font-medium">Sumate a la historia de POSALANA.</p>
			</div>

			<form method="post" action="/api/register" enctype="application/x-www-form-urlencoded" class="space-y-5">
				<div class="space-y-1">
					<label for="register-display-name" class="block text-sm font-bold">Tu nombre</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-address-card"></i>
						</div>
						<input type="text" id="register-display-name" name="display_name" class="campo pl-10" placeholder="Ej: Juan, Mati" required aria-describedby="register-display-name-help" />
					</div>
					<p id="register-display-name-help" class="text-chico text-lutvia-texto-suave mt-1">Este nombre lo ven todos.</p>
				</div>

				<div class="space-y-1">
					<label for="register-username" class="block text-sm font-bold">Nombre de usuario (para entrar)</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-user"></i>
						</div>
						<input type="text" id="register-username" name="username" autocomplete="username" class="campo pl-10" placeholder="usuario_unico" required />
					</div>
				</div>

				<div class="space-y-1">
					<label for="register-password" class="block text-sm font-bold">Contraseña</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-key"></i>
						</div>
						<input type="password" id="register-password" name="password" autocomplete="new-password" class="campo pl-10" required minlength="4" />
					</div>
				</div>

				<button type="submit" class="boton boton-principal w-full py-3.5 mt-6">
					<i class="fa-solid fa-user-plus" aria-hidden="true"></i> Crear cuenta
				</button>
			</form>

			<div class="mt-8 pt-6 border-t border-lutvia-oscuro-16 text-center space-y-3">
				<p class="text-sm font-semibold text-lutvia-oscuro">
					¿Ya tenés cuenta? <a href="/login" class="enlace">Iniciá sesión acá</a>
				</p>
			</div>
		</div>
	</div>
</Layout>
