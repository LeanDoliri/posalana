---
import Layout from '../layouts/Layout.astro';
import db from '../db/index.js';
import { getSeasonId, getExemptionsForSeason } from '../utils/season.js';
import UserAvatar from '../components/UserAvatar.astro';
import DiceDisplay from '../components/DiceDisplay.astro';
import ScheduleNotice from '../components/ScheduleNotice.astro';
import { formatDate } from '../utils/date.js';
import { getArgentinaNow, getRollSchedule, getRollWindowStatus, SCHEDULE_NOTICE_UNTIL } from '../utils/schedule.js';
import { assignDailyChores, chores, safeChore, choreStyles } from '../utils/chores.js';

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}

const user = Astro.locals.user;

// Fecha y horario de tirada en GMT-3
const now = getArgentinaNow();
const dateStr = now.dateStr;
const schedule = await getRollSchedule(db);
const windowStatus = getRollWindowStatus(schedule, now.minutes);
const canRoll = windowStatus === 'open' || user.role === 'tester';
const showScheduleNotice = dateStr <= SCHEDULE_NOTICE_UNTIL;

// Check if user rolled
const userRollRes = await db.execute({
    sql: "SELECT * FROM roll WHERE user_id = ? AND date = ?",
    args: [user.id, dateStr]
});
const hasRolled = userRollRes.rows.length > 0;
const myRoll = hasRolled ? userRollRes.rows[0] : null;

// Get all rolls for today, ordered by rules
const allRollsRes = await db.execute({
    sql: `
        SELECT r.*, u.username, u.display_name, u.avatar_url
        FROM roll r
        JOIN user u ON r.user_id = u.id
        WHERE r.date = ?
        ORDER BY r.die1 ASC, r.die2 ASC, r.die3 ASC, r.die4 ASC
    `,
    args: [dateStr]
});
const allRolls = allRollsRes.rows;

// Fetch exemptions
const seasonId = getSeasonId(dateStr);
const exemptions = await getExemptionsForSeason(db, seasonId);

const { rollChoreMap, lomitoActivated, lomitoPlayers, sortedRolls } = assignDailyChores(allRolls, exemptions);

const assignedLA = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'LA');
const assignedSA = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'SA');
const assignedPO = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'PO');
const savedPlayers = sortedRolls.filter(r => rollChoreMap.get(r.id)?.code === 'NA');

const myChore = myRoll ? (rollChoreMap.get(myRoll.id) || safeChore) : null;

// Columnas del podio: PO a la izquierda, SA al centro y LA a la derecha
const podium = [
    { roll: assignedPO, code: 'PO', label: 'Pone la mesa', block: 'PONE', float: 'animate-float' },
    { roll: assignedSA, code: 'SA', label: 'Saca la mesa', block: 'SACA', float: 'animate-float' },
    { roll: assignedLA, code: 'LA', label: 'Lava los platos', block: 'LAVA', float: 'animate-float' },
];
---
<Layout>
    <div class="space-y-10 animate-in fade-in">

        <!-- Podio -->
        <div id="podium-container">
            {allRolls.length >= 3 && (
                <section class="bg-lutvia-blanco p-4 sm:p-6 md:p-8 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-black text-lutvia-oscuro tracking-tight flex items-center justify-center gap-2">
                            <i class="fa-solid fa-scroll text-lutvia-violeta" aria-hidden="true"></i> Veredicto de tareas
                        </h3>
                        <p class="text-xs text-lutvia-texto-suave mt-1 font-medium">El podio de la mala suerte: los designados para la lavación, sacación y ponición de mesa de hoy.</p>
                    </div>

                    <div class="flex items-end justify-center gap-2 sm:gap-6 pt-8 pb-4 max-w-2xl mx-auto">
                        {podium.map(({ roll, code, label, block, float }) => {
                            const chore = chores.find(c => c.code === code)!;
                            return (
                                <div class={`flex flex-col items-center flex-1 ${float}`}>
                                    {roll ? (
                                        <div class="flex flex-col items-center mb-3 text-center animate-in fade-in slide-in-from-bottom-2 w-full">
                                            <UserAvatar user={{ username: roll.username as string, display_name: roll.display_name as string, avatar_url: roll.avatar_url as string }} size="lg" />
                                            <div class="mt-2 flex justify-center">
                                                <DiceDisplay die1={roll.die1 as number} die2={roll.die2 as number} die3={roll.die3 as number} die4={roll.die4 as number} size="sm" color={choreStyles[code].dado} />
                                            </div>
                                            <span class="font-black text-lutvia-oscuro text-xs sm:text-sm mt-2 block text-center leading-tight px-1">{roll.display_name}</span>
                                        </div>
                                    ) : (
                                        <div class="flex flex-col items-center mb-3 text-center w-full">
                                            <div class="w-16 h-16 rounded-lutvia-pildora border-2 border-dashed border-lutvia-texto-suave flex items-center justify-center text-lutvia-texto-suave text-lg">
                                                <i class="fa-solid fa-question" aria-hidden="true"></i>
                                            </div>
                                            <span class="font-bold text-lutvia-texto-suave text-xs sm:text-sm mt-2 block">Vacante</span>
                                            <span class={`etiqueta mt-1 ${choreStyles[code].etiqueta}`}>
                                                <span aria-hidden="true">{chore.emoji}</span> {label}
                                            </span>
                                        </div>
                                    )}
                                    <!-- Escalón del podio: relleno gris con el acento de color de la sílaba arriba -->
                                    <div class={`w-full bg-lutvia-gris border-t-4 ${choreStyles[code].barra} rounded-t-lutvia-radio-chico h-16 sm:h-20 flex items-center justify-center`}>
                                        <span class="text-xs sm:text-sm font-black text-lutvia-oscuro select-none tracking-wider">{block}</span>
                                    </div>
                                </div>
                            );
                        })}
                    </div>

                    {savedPlayers.length > 0 && (
                        <div class="mt-6 pt-4 border-t border-lutvia-oscuro-16 flex flex-col items-center justify-center gap-3">
                            <p class="text-xs font-semibold text-lutvia-texto-suave text-center">
                                El resto de los participantes que tiraron hoy zafaron de las tareas.
                            </p>
                            <span class={`etiqueta uppercase tracking-wider ${choreStyles.NA.etiqueta}`}>
                                <span aria-hidden="true">{safeChore.emoji}</span> Nada
                            </span>
                        </div>
                    )}
                </section>
            )}
        </div>

        <!-- Tarjeta de la tirada (PosalanaTarjetaTirada) -->
        <div id="hero-container">
        {hasRolled && myRoll && myChore ? (
            <section class="bg-lutvia-blanco p-4 md:p-6 rounded-3xl shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
                <div class="text-center sm:text-left">
                    <p class="rotulo mb-1">Tirada del {formatDate(dateStr)}</p>
                    <p class="text-sm text-lutvia-oscuro font-medium">Ya cumpliste con tu destino de hoy.</p>
                    <p class="mt-2">
                        <span class={`etiqueta ${choreStyles[myChore.code].etiqueta}`}>
                            <span aria-hidden="true">{myChore.emoji}</span> {myChore.code} · {myChore.label}
                        </span>
                    </p>
                </div>
                <div class="flex items-center gap-3 bg-lutvia-gris px-4 py-2 rounded-lutvia-radio">
                    <p class="rotulo mr-2 hidden md:block">Tu suerte</p>
                    <DiceDisplay die1={myRoll.die1 as number} die2={myRoll.die2 as number} die3={myRoll.die3 as number} die4={myRoll.die4 as number} size="lg" color={choreStyles[myChore.code].dado} />
                </div>
            </section>
        ) : (
            <section class="bg-lutvia-blanco p-8 md:p-12 rounded-3xl shadow-xl text-center animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
                <p class="rotulo mb-2">Tirada oficial</p>
                <h2 class="text-4xl md:text-5xl font-black mb-2 tracking-tight text-lutvia-oscuro text-balance tabular-nums">{formatDate(dateStr)}</h2>
                {canRoll ? (
                <>
                <p class="text-lutvia-texto-suave mb-3 max-w-md mx-auto text-pretty">El destino no está escrito, se decide con los dados. ¿Zafás o lavás?</p>
                <p class="etiqueta bg-lutvia-cyan/15 mb-8">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i> La tirada cierra a las {schedule.end}
                </p>

                <form method="post" action="/api/roll" id="roll-form">
                    <!-- Botón de tirar (PosalanaBotonTirar): el único principal de la pantalla -->
                    <button type="submit" id="roll-button" class="boton boton-principal group px-10 py-5 text-xl uppercase">
                        <i class="fa-solid fa-dice text-2xl motion-safe:group-hover:rotate-180 transition-transform" id="roll-icon" aria-hidden="true"></i>
                        <span id="roll-text">Tirar los dados</span>
                    </button>
                </form>
                </>
                ) : windowStatus === 'before' ? (
                <>
                    <p class="text-lutvia-texto-suave mb-8 max-w-md mx-auto text-pretty">Los dados todavía están guardados. Paciencia, que el destino tiene horario.</p>
                    <div class="inline-flex flex-col items-center gap-1 bg-lutvia-gris px-8 py-5 rounded-lutvia-radio">
                        <span class="rotulo"><i class="fa-solid fa-lock mr-1" aria-hidden="true"></i> La tirada abre a las</span>
                        <span class="text-4xl font-black text-lutvia-oscuro tabular-nums">{schedule.start}</span>
                        <span class="text-xs text-lutvia-texto-suave font-medium">y cierra a las {schedule.end}</span>
                    </div>
                </>
                ) : (
                <>
                    <p class="text-lutvia-texto-suave mb-8 max-w-md mx-auto text-pretty">La mesa está cerrada y el veredicto final ya es definitivo. Si no tiraste, hoy no jugás.</p>
                    <div class="inline-flex flex-col items-center gap-1 bg-lutvia-gris px-8 py-5 rounded-lutvia-radio">
                        <span class="rotulo"><i class="fa-solid fa-door-closed mr-1 text-lutvia-rosa" aria-hidden="true"></i> Tirada cerrada a las {schedule.end}</span>
                        <span class="text-sm text-lutvia-oscuro font-medium">Volvé mañana de {schedule.start} a {schedule.end}</span>
                    </div>
                </>
                )}
            </section>
        )}
        </div>

        <!-- Banner de la Cláusula Lomito -->
        <div id="lomito-container">
            {lomitoActivated && (
                <section class="bg-lutvia-blanco border-2 border-lutvia-violeta p-8 rounded-3xl shadow-xl text-center animate-in zoom-in-95" aria-live="polite">
                    <!-- Título en violeta: Permitido del perfil, solo este título y en Black 900 de 24 px o más -->
                    <h3 class="text-2xl md:text-3xl font-black text-lutvia-violeta mb-2 tracking-tight text-balance">
                        <span aria-hidden="true">🥪</span> ¡Cláusula Lomito activada!
                    </h3>
                    <p class="text-lutvia-oscuro text-lg md:text-xl font-semibold mb-1 text-pretty">{lomitoPlayers.join(" y ")} rompieron la matrix.</p>
                    <p class="text-lutvia-texto-suave font-medium text-pretty">Sus dados son idénticos. ¡Hoy se almuerzan lomitos con papas!</p>
                </section>
            )}
        </div>

        <!-- Ranking del día -->
        <section id="ranking-container" class="bg-lutvia-blanco p-4 sm:p-6 md:p-10 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-lutvia-oscuro-16">
                <h3 class="text-2xl font-black tracking-tight text-lutvia-oscuro flex items-center gap-3 text-balance">
                    <i class="fa-solid fa-trophy" aria-hidden="true"></i> Ranking POSALANA
                </h3>
            </div>

            {allRolls.length === 0 ? (
                <div class="py-16 text-center border-2 border-dashed border-lutvia-oscuro-16 rounded-lutvia-radio">
                    <div class="text-4xl mb-4 text-lutvia-texto-suave"><i class="fa-solid fa-ghost" aria-hidden="true"></i></div>
                    <p class="text-lutvia-texto-suave font-medium text-lg">Nadie se animó a tirar todavía.</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 gap-4">
                    {sortedRolls.map((roll) => {
                        const chore = rollChoreMap.get(roll.id) || safeChore;
                        const code = (chore.code in choreStyles ? chore.code : 'NA') as 'PO' | 'SA' | 'LA' | 'NA';
                        const style = choreStyles[code];
                        const isMe = String(roll.user_id) === String(user.id);
                        const userExemptions = exemptions.filter(e => String(e.user_id) === String(roll.user_id));

                        return (
                            <!-- Fila del ranking: relleno gris, radio chico; la tuya lleva un borde oscuro y la etiqueta "Vos" -->
                            <div class={`flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-lutvia-radio-chico bg-lutvia-gris ${isMe ? 'ring-2 ring-lutvia-oscuro' : ''}`}>
                                <div class="flex items-center gap-4 w-full sm:w-auto">
                                    <UserAvatar user={roll as any} size="lg" border={true} />
                                    <div class="flex-grow min-w-0">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="font-black text-lutvia-oscuro text-xl leading-tight">{roll.display_name}</p>
                                            {isMe && (
                                                <span class="etiqueta bg-lutvia-blanco uppercase tracking-wider">
                                                    <i class="fa-solid fa-circle-user" aria-hidden="true"></i> Vos
                                                </span>
                                            )}
                                            <span class={`etiqueta uppercase tracking-widest ${code === 'NA' ? 'bg-lutvia-blanco' : style.etiqueta}`}>
                                                {chore.code}
                                            </span>
                                            {userExemptions.map(ex => {
                                                const targetChore = chores.find(c => c.code === ex.chore_code);
                                                const choreLabel = targetChore ? targetChore.label.split(' ')[0] : ex.chore_code;
                                                return (
                                                    <span class="etiqueta bg-lutvia-violeta/15 uppercase tracking-wider" title={`Exento de: ${targetChore ? targetChore.label : ex.chore_code}`}>
                                                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Exento {choreLabel}
                                                    </span>
                                                )
                                            })}
                                        </div>
                                        {roll.time && <span class="inline-flex items-center gap-1 mt-1 text-xs text-lutvia-texto-suave tabular-nums"><i class="fa-regular fa-clock" aria-hidden="true"></i> {roll.time}</span>}
                                        <div class="font-bold mt-1 text-sm text-lutvia-oscuro whitespace-nowrap">
                                            <span aria-hidden="true">{chore.emoji}</span> {chore.label}
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-center sm:justify-end w-full sm:w-auto">
                                    <DiceDisplay die1={roll.die1 as number} die2={roll.die2 as number} die3={roll.die3 as number} die4={roll.die4 as number} size="xl" color={style.dado} />
                                </div>
                            </div>
                        )
                    })}
                </div>
            )}
        </section>

        <!-- Polling y animación de la tirada -->
        <script is:inline>
            (function() {
                const POLL_INTERVAL = 8000;
                let intervalId = null;

                const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                async function checkUpdates() {
                    try {
                        const response = await fetch(window.location.href, { cache: 'no-cache' });
                        if (!response.ok) return;

                        const text = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(text, "text/html");

                        // 1. Update Ranking
                        const newRanking = doc.getElementById("ranking-container");
                        const oldRanking = document.getElementById("ranking-container");
                        if (newRanking && oldRanking && newRanking.innerHTML !== oldRanking.innerHTML) {
                            oldRanking.innerHTML = newRanking.innerHTML;
                        }

                        // 2. Update Podium
                        const newPodium = doc.getElementById("podium-container");
                        const oldPodium = document.getElementById("podium-container");
                        if (newPodium && oldPodium && newPodium.innerHTML !== oldPodium.innerHTML) {
                            oldPodium.innerHTML = newPodium.innerHTML;
                        }

                        // 3. Update Hero (abre/cierra la tirada según el horario)
                        const newHero = doc.getElementById("hero-container");
                        const oldHero = document.getElementById("hero-container");
                        const rollingNow = document.getElementById("roll-overlay")?.classList.contains("flex");
                        if (!rollingNow && newHero && oldHero && newHero.innerHTML !== oldHero.innerHTML) {
                            oldHero.innerHTML = newHero.innerHTML;
                            setupRollAnimation();
                        }

                        // 4. Update Lomito Banner and check for new Lomito activation
                        const newLomito = doc.getElementById("lomito-container");
                        const oldLomito = document.getElementById("lomito-container");
                        if (newLomito && oldLomito && newLomito.innerHTML !== oldLomito.innerHTML) {
                            const hadLomito = oldLomito.querySelector("section") !== null;
                            const hasLomito = newLomito.querySelector("section") !== null;

                            oldLomito.innerHTML = newLomito.innerHTML;

                            // Trigger confetti if Lomito just got activated
                            if (!hadLomito && hasLomito) {
                                triggerConfetti();
                            }
                        }
                    } catch (error) {
                        console.error("Error checking for updates:", error);
                    }
                }

                function triggerConfetti() {
                    if (prefersReducedMotion()) return;
                    if (typeof window.confetti === "function") {
                        runConfetti();
                    } else {
                        const script = document.createElement("script");
                        script.src = "https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js";
                        script.onload = runConfetti;
                        document.body.appendChild(script);
                    }
                }

                // Confetti con los cuatro colores vivos, leídos de los tokens
                function runConfetti() {
                    const styles = getComputedStyle(document.documentElement);
                    const colors = ['rosa', 'cyan', 'amarillo', 'violeta'].map(c => styles.getPropertyValue(`--lutvia-${c}`).trim());
                    const duration = 5 * 1000;
                    const animationEnd = Date.now() + duration;
                    const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 100, colors, disableForReducedMotion: true };

                    function randomInRange(min, max) {
                        return Math.random() * (max - min) + min;
                    }

                    const interval = setInterval(() => {
                        const timeLeft = animationEnd - Date.now();
                        if (timeLeft <= 0) {
                            return clearInterval(interval);
                        }
                        const particleCount = 50 * (timeLeft / duration);
                        window.confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                        window.confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                    }, 250);
                }

                function startPolling() {
                    if (!intervalId) {
                        intervalId = setInterval(checkUpdates, POLL_INTERVAL);
                    }
                }

                function stopPolling() {
                    if (intervalId) {
                        clearInterval(intervalId);
                        intervalId = null;
                    }
                }

                function handleVisibilityChange() {
                    if (document.hidden) {
                        stopPolling();
                    } else {
                        checkUpdates();
                        startPolling();
                    }
                }

                function setupRollAnimation() {
                    const rollForm = document.getElementById('roll-form');
                    const rollButton = document.getElementById('roll-button');
                    const rollOverlay = document.getElementById('roll-overlay');
                    const overlayStatusText = document.getElementById('overlay-status-text');

                    if (rollForm && rollButton && rollOverlay) {
                        rollForm.addEventListener('submit', (e) => {
                            e.preventDefault();

                            // Show full-screen overlay
                            rollOverlay.classList.remove('hidden');
                            rollOverlay.classList.add('flex');

                            // Ya tirado: el botón pasa al estado deshabilitado del sistema
                            rollButton.disabled = true;

                            // Las caras cambian solas mientras ruedan; con movimiento reducido quedan quietas
                            let faceChangeInterval = null;
                            if (!prefersReducedMotion()) {
                                const diceIcons = rollOverlay.querySelectorAll('[data-overlay-die]');
                                const diceWords = ['one', 'two', 'three', 'four', 'five', 'six'];
                                faceChangeInterval = setInterval(() => {
                                    diceIcons.forEach(icon => {
                                        diceWords.forEach(word => icon.classList.remove(`fa-dice-${word}`));
                                        const randomVal = Math.floor(Math.random() * 6);
                                        icon.classList.add(`fa-dice-${diceWords[randomVal]}`);
                                    });
                                }, 60);
                            }

                            // Change status texts for suspense
                            setTimeout(() => {
                                if (overlayStatusText) overlayStatusText.textContent = 'Calculando trayectorias...';
                            }, 500);

                            setTimeout(() => {
                                if (overlayStatusText) overlayStatusText.textContent = 'Escribiendo el destino...';
                            }, 1000);

                            // Submit form after 1.5 seconds
                            setTimeout(() => {
                                if (faceChangeInterval) clearInterval(faceChangeInterval);
                                rollForm.submit();
                            }, 1500);
                        });
                    }
                }

                // Initialize under View Transitions lifecycle
                document.addEventListener('astro:page-load', () => {
                    stopPolling();
                    setupRollAnimation();

                    // Si el banner de Lomito ya está al cargar, se festeja
                    if (document.querySelector('#lomito-container section')) {
                        triggerConfetti();
                    }

                    document.addEventListener("visibilitychange", handleVisibilityChange);
                    if (!document.hidden) {
                        startPolling();
                    }
                });

                document.addEventListener('astro:before-preparation-change', () => {
                    stopPolling();
                    document.removeEventListener("visibilitychange", handleVisibilityChange);
                });
            })();
        </script>

        {showScheduleNotice && <ScheduleNotice start={schedule.start} end={schedule.end} dateStr={dateStr} />}

        <!-- Pantalla de la tirada: fondo lleno en gris y la tarjeta blanca encima -->
        <div id="roll-overlay" class="fixed inset-0 z-[100] bg-lutvia-gris hidden flex-col items-center justify-center animate-in fade-in" role="status" aria-live="polite">
            <div class="bg-lutvia-blanco p-8 sm:p-12 rounded-3xl shadow-xl flex flex-col items-center gap-8 max-w-md w-[90%] text-center animate-in zoom-in-95">
                <p class="rotulo animate-pulse">Invocando al destino</p>

                <div class="flex items-center justify-center gap-6 text-5xl sm:text-6xl md:text-7xl py-4" aria-hidden="true">
                    <i data-overlay-die class="fa-solid fa-dice-one text-lutvia-rosa animate-shake-roll"></i>
                    <i data-overlay-die class="fa-solid fa-dice-two text-lutvia-violeta animate-shake-roll [animation-delay:0.1s]"></i>
                    <i data-overlay-die class="fa-solid fa-dice-three text-lutvia-oscuro animate-shake-roll [animation-delay:0.2s]"></i>
                    <i data-overlay-die class="fa-solid fa-dice-four text-lutvia-texto-suave animate-shake-roll [animation-delay:0.3s]"></i>
                </div>

                <div class="space-y-2">
                    <h3 class="text-2xl font-black text-lutvia-oscuro tracking-tight" id="overlay-status-text">Lanzando los dados...</h3>
                    <p class="text-xs text-lutvia-texto-suave font-medium">¿Zafás o lavás? El destino se está decidiendo ahora mismo.</p>
                </div>

                <!-- Barra con el degradé de los cuatro colores vivos -->
                <div class="w-full bg-lutvia-gris h-2 rounded-lutvia-pildora overflow-hidden">
                    <div class="degrade-lutvia h-full w-full rounded-lutvia-pildora animate-pulse"></div>
                </div>
            </div>
        </div>
    </div>
</Layout>
