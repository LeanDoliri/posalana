---
import Layout from "../layouts/Layout.astro";
import db from "../db/index.js";
import { getRollSchedule } from "../utils/schedule.js";
import { chores, safeChore, choreStyles } from "../utils/chores.js";

const schedule = await getRollSchedule(db);

// Las cuatro tareas, del peor tiro al mejor
const choreRules = [
  { ...chores.find(c => c.code === "LA")!, hint: "El peor tiro absoluto" },
  { ...chores.find(c => c.code === "SA")!, hint: "El segundo peor tiro" },
  { ...chores.find(c => c.code === "PO")!, hint: "El tercer peor tiro" },
  { ...safeChore, hint: "¡Zafaste, no hacés nada!" },
];
---

<Layout>
  <div class="space-y-10 animate-in fade-in">
    <!-- Encabezado -->
    <section class="text-center pb-8 border-b border-lutvia-oscuro-16 animate-in fade-in slide-in-from-bottom-4">
      <h2 class="text-4xl md:text-5xl font-black mb-4 tracking-tight text-lutvia-oscuro text-balance">
        Reglas del POSALANA
      </h2>
      <p class="text-lg text-lutvia-texto-suave max-w-2xl mx-auto text-pretty">
        El reglamento oficial para definir quién pone, saca, lava, o se salva de
        hacer nada.
      </p>
      <p class="rotulo mt-4">
        Última actualización: 13/10/2026
      </p>
    </section>

    <!-- Qué es y mecánica -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start animate-in fade-in slide-in-from-bottom-4">
      <div class="bg-lutvia-blanco p-8 rounded-3xl shadow-xl hover-card-lift">
        <h3 class="text-2xl font-bold mb-6 flex items-center gap-3 text-balance">
          <i class="fa-solid fa-circle-question" aria-hidden="true"></i> ¿Qué es POSALANA?
        </h3>
        <p class="text-lutvia-oscuro leading-relaxed mb-6 text-pretty">
          Todos los días, cada participante debe tirar los dados una vez para
          definir su tarea en la mesa. Las tareas se asignan desde el tiro más
          bajo (peor suerte) hasta el más alto.
        </p>

        <ul class="space-y-4">
          {choreRules.map(rule => (
            <li class="flex items-center gap-4 p-3">
              <!-- La sílaba sobre el matiz al 15 % de su color, con texto oscuro -->
              <span class={`shrink-0 flex items-center justify-center w-12 h-12 ${choreStyles[rule.code].etiqueta} text-lutvia-oscuro font-black rounded-lutvia-radio-chico`}>
                {rule.code}
              </span>
              <div>
                <p class="font-bold">{rule.label}</p>
                <p class="text-xs text-lutvia-texto-suave">{rule.hint} <span aria-hidden="true">{rule.emoji}</span></p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Mecánica -->
      <div class="space-y-8">
        <div class="bg-lutvia-blanco p-8 rounded-3xl shadow-xl hover-card-lift">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            <i class="fa-solid fa-dice" aria-hidden="true"></i> La tirada
          </h3>
          <ul class="space-y-3 text-lutvia-oscuro list-disc pl-5">
            <li>
              Se tiran <strong>4 dados</strong> una vez por día en la app.
            </li>
            <li>
              El tiro más bajo en el 1º dado <strong>LAVA</strong>, el 2º
              <strong>SACA</strong>, el 3º <strong>PONE</strong>.
            </li>
            <li>
              En caso de empate, desempata el 2º dado, y así sucesivamente.
            </li>
            <li>
              Solo se puede tirar de <strong>{schedule.start}</strong> a
              <strong>{schedule.end}</strong>. A las {schedule.end} la mesa se
              cierra y el <strong>veredicto final</strong>
              se publica solo en Discord (si ese día nadie tiró, no se
              publica nada).
            </li>
          </ul>
        </div>

        <div class="bg-lutvia-blanco p-8 rounded-3xl shadow-xl hover-card-lift">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            <i class="fa-solid fa-calendar-week" aria-hidden="true"></i> Temporadas
          </h3>
          <ul class="space-y-3 text-lutvia-oscuro list-disc pl-5">
            <li>
              Hacer las tareas de <strong>Lavar</strong>, <strong>Sacar</strong>
              o <strong>Poner</strong> suma <strong>1 punto</strong> en esa
              categoría específica.
            </li>
            <li>
              Al final de la temporada, se hace un recuento. Quien tenga <strong
                >más puntos acumulados en una tarea</strong
              >, se consagra ganador de esa categoría y queda <strong
                >exento</strong
              > de realizarla durante toda la siguiente temporada.
            </li>
            <li>
              Si estás exento de una tarea y los dados te designan para hacerla,
              ¡te salvás y pasás a no hacer nada! (No se suman puntos estando
              exento).
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Horarios y llegadas tarde -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-in fade-in slide-in-from-bottom-4">
      <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-lutvia-blanco rounded-3xl p-6 shadow-xl hover-card-lift">
          <p class="rotulo mb-2">
            <i class="fa-solid fa-dice mr-1" aria-hidden="true"></i> Tiempo de tiración
          </p>
          <p class="text-3xl font-black text-lutvia-oscuro mb-2 tabular-nums">
            {schedule.start} <span class="text-lutvia-texto-suave font-normal">a</span> {schedule.end}
          </p>
          <p class="text-sm text-lutvia-oscuro">
            Fuera de ese horario la app no deja tirar. Si no tiraste antes del
            cierre, ese día no jugás.
          </p>
        </div>
        <div class="bg-lutvia-blanco rounded-3xl p-6 shadow-xl hover-card-lift">
          <p class="rotulo mb-2">
            <i class="fa-solid fa-utensils mr-1" aria-hidden="true"></i> Llevación de platos
          </p>
          <p class="text-3xl font-black text-lutvia-oscuro mb-2 tabular-nums">
            12:30 <span class="text-lutvia-texto-suave font-normal">a</span> 13:00
          </p>
          <p class="text-sm text-lutvia-oscuro">
            Si no llegás antes de las 13:00, no jugás.
          </p>
        </div>
      </div>

      <!-- Llegadas tarde -->
      <div class="bg-lutvia-blanco rounded-3xl p-6 flex flex-col justify-center shadow-xl hover-card-lift">
        <h3 class="font-bold text-lutvia-oscuro mb-3 flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-lutvia-rosa" aria-hidden="true"></i> Llegadas tarde
        </h3>
        <p class="text-sm text-lutvia-oscuro mb-3">
          Llegar después de las <strong>10:15</strong> sin aviso previo excluye de
          la tirada e implica <strong>lavar los platos directamente</strong>.
        </p>
        <p class="text-sm text-lutvia-oscuro">
          Si llegan varios tarde, se reparten las tareas según el orden de
          llegada.
        </p>
      </div>
    </section>

    <!-- Cláusula Lomito -->
    <section class="bg-lutvia-blanco border-2 border-lutvia-violeta p-8 md:p-10 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
      <div class="text-center md:text-left">
        <h3 class="text-2xl font-black text-lutvia-oscuro mb-2 text-balance">
          <span aria-hidden="true">🥪</span> La Cláusula Lomito
        </h3>
        <p class="text-lutvia-oscuro leading-relaxed max-w-3xl text-pretty mb-6">
          Si la tirada de dos personas es <strong>exactamente igual</strong> en
          valores y orden, las coincidencias se celebran. El contador de la app
          se reinicia a cero y <strong>LUTVIA</strong> garantiza un almuerzo de
          <strong>lomitos con papas</strong> ese mismo día.
        </p>
        <div class="border-t border-lutvia-oscuro-16 pt-6">
          <h4 class="rotulo mb-3 flex items-center gap-2">
            <i class="fa-solid fa-chart-simple text-lutvia-violeta" aria-hidden="true"></i> Probabilidad del milagro (para 10 jugadores, 3 tiradas por semana)
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-lutvia-gris p-4 rounded-lutvia-radio">
              <p class="text-xs text-lutvia-texto-suave font-medium">En el día (1 tirada)</p>
              <p class="text-2xl font-black text-lutvia-oscuro mt-1 tabular-nums">3,42%</p>
            </div>
            <div class="bg-lutvia-gris p-4 rounded-lutvia-radio">
              <p class="text-xs text-lutvia-texto-suave font-medium">En el mes (~13 tiradas)</p>
              <p class="text-2xl font-black text-lutvia-oscuro mt-1 tabular-nums">36,40%</p>
            </div>
            <div class="bg-lutvia-gris p-4 rounded-lutvia-radio">
              <p class="text-xs text-lutvia-texto-suave font-medium">En el año (~156 tiradas)</p>
              <p class="text-2xl font-black text-lutvia-oscuro mt-1 tabular-nums">99,56%</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <p class="text-center text-sm text-lutvia-texto-suave pb-8">
      <i class="fa-solid fa-microchip" aria-hidden="true"></i> Las tiradas en esta app son aleatorias,
      inmutables y en tiempo real.
    </p>
  </div>
</Layout>
