---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
	return Astro.redirect('/');
}
---

<Layout>
	<div class="min-h-[70vh] flex items-center justify-center animate-in fade-in slide-in-from-bottom-4">
		<div class="w-full max-w-md bg-lutvia-blanco p-10 rounded-3xl shadow-xl">
			<div class="text-center mb-8">
				<div class="inline-flex items-center justify-center w-16 h-16 rounded-lutvia-pildora bg-lutvia-gris text-lutvia-oscuro mb-4" aria-hidden="true">
					<i class="fa-solid fa-unlock-keyhole text-2xl"></i>
				</div>
				<h2 class="text-2xl font-black text-lutvia-oscuro tracking-tight">Restablecer clave</h2>
				<p class="text-lutvia-texto-suave mt-2 font-medium text-sm">Ingresá tu usuario y elegí una contraseña nueva.</p>
			</div>

			<form method="post" action="/api/reset" enctype="application/x-www-form-urlencoded" class="space-y-4">
				<div class="space-y-1">
					<label for="reset-username" class="block text-sm font-bold">Usuario</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-user"></i>
						</div>
						<input type="text" id="reset-username" name="username" autocomplete="username" class="campo pl-10" required />
					</div>
				</div>

				<div class="space-y-1">
					<label for="reset-password" class="block text-sm font-bold">Nueva contraseña</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-lutvia-texto-suave" aria-hidden="true">
							<i class="fa-solid fa-key"></i>
						</div>
						<input type="password" id="reset-password" name="new_password" autocomplete="new-password" class="campo pl-10" required />
					</div>
				</div>

				<button type="submit" class="boton boton-principal w-full py-3.5 mt-6">
					<i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i> Restablecer
				</button>
			</form>

			<div class="mt-8 pt-6 border-t border-lutvia-oscuro-16 text-center">
				<p class="text-sm font-semibold">
					<a href="/login" class="enlace"><i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Volver a iniciar sesión</a>
				</p>
			</div>
		</div>
	</div>
</Layout>
