---
import Layout from "../layouts/Layout.astro";
import db from "../db/index.js";
import UserAvatar from "../components/UserAvatar.astro";
import DiceDisplay from "../components/DiceDisplay.astro";
import { getSeasonId, getPreviousSeasons, formatSeasonName } from "../utils/season.js";
import { getArgentinaNow, getRollSchedule, getRollWindowStatus } from "../utils/schedule.js";
import { formatDate } from "../utils/date.js";
import { chores, choreStyles } from "../utils/chores.js";

const { user } = Astro.locals;

if (!user || user.role !== "admin") {
	return Astro.redirect("/");
}

// Fetch all users
const usersRes = await db.execute("SELECT id, username, display_name, avatar_url, role FROM user ORDER BY username ASC");
const allUsers = usersRes.rows;

// Fetch all exemptions
const exemptionsRes = await db.execute(`
    SELECT e.id, e.season_id, e.chore_code, u.username, u.display_name, u.avatar_url 
    FROM exemption e
    JOIN user u ON e.user_id = u.id
    ORDER BY e.season_id DESC, u.username ASC
`);
const allExemptions = exemptionsRes.rows;

// Fetch all rolls
const rollsRes = await db.execute(`
	SELECT r.id, r.date, r.die1, r.die2, r.die3, r.die4, u.username, u.display_name, u.avatar_url 
	FROM roll r 
	JOIN user u ON r.user_id = u.id 
	ORDER BY r.date DESC, r.id DESC
	LIMIT 50
`);
const recentRolls = rollsRes.rows;

// Fetch recent password resets
const resetsRes = await db.execute(`
	SELECT id, username, created_at FROM password_reset_log
	ORDER BY created_at DESC
	LIMIT 50
`);
const recentResets = resetsRes.rows;

// Format an ISO timestamp in Argentina time (GMT-3)
function formatResetDate(iso: string) {
	const d = new Date(iso);
	d.setHours(d.getHours() - 3);
	const local = d.toISOString();
	return `${formatDate(local)} ${local.substring(11, 16)} (GMT-3)`;
}

// Fetch global settings
const settingsRes = await db.execute("SELECT key, value FROM settings");
const settingsMap = new Map();
settingsRes.rows.forEach((s: any) => settingsMap.set(s.key, s.value));

// Calculate current date in GMT-3 to obtain current season
const now = getArgentinaNow();
const dateStr = now.dateStr;
const currentSeason = getSeasonId(dateStr);

// Horario de tirada y estado del veredicto automático de hoy
const schedule = await getRollSchedule(db);
const windowStatus = getRollWindowStatus(schedule, now.minutes);
const windowStatusLabel = {
    before: { text: `Cerrada · abre a las ${schedule.start}`, cls: 'bg-lutvia-gris' },
    open: { text: `Abierta · cierra a las ${schedule.end}`, cls: 'bg-lutvia-cyan' },
    closed: { text: `Cerrada desde las ${schedule.end}`, cls: 'bg-lutvia-rosa/15' },
}[windowStatus];
const autoVerdictToday = schedule.autoVerdictLastDate === dateStr;
const autoVerdictLabel = !schedule.autoVerdictEnabled
    ? 'Desactivado'
    : autoVerdictToday
        ? (schedule.autoVerdictLastAt === 'sin tiradas' ? 'Hoy no se envió (nadie tiró)' : `Enviado hoy a las ${schedule.autoVerdictLastAt}`)
        : `Pendiente · sale a las ${schedule.end}`;

// Get current season and last 2 seasons
const recentSeasons = getPreviousSeasons(currentSeason, 2);

// Fetch distinct season_ids present in manual_points and exemption tables
const dbSeasonsRes = await db.execute(`
    SELECT DISTINCT season_id FROM exemption
    UNION
    SELECT DISTINCT season_id FROM manual_points
`);
const dbSeasons = dbSeasonsRes.rows.map((r: any) => r.season_id).filter(Boolean);

// Combine, de-duplicate and sort (newest to oldest)
const seasonsOrder = ['verano', 'otoño', 'invierno', 'primavera'];
const uniqueSeasons = Array.from(new Set([...recentSeasons, ...dbSeasons]));
uniqueSeasons.sort((a, b) => {
    const [yearA, nameA] = a.split('-');
    const [yearB, nameB] = b.split('-');
    if (yearA !== yearB) {
        return parseInt(yearB) - parseInt(yearA);
    }
    return seasonsOrder.indexOf(nameB) - seasonsOrder.indexOf(nameA);
});
---

<Layout>
	<div class="space-y-10 animate-in fade-in">
		<header class="text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4 border-b border-lutvia-oscuro-16 pb-8 animate-in fade-in slide-in-from-bottom-4">
			<div>
				<h2 class="text-3xl font-black text-lutvia-oscuro tracking-tight"><i class="fa-solid fa-screwdriver-wrench text-lutvia-rosa mr-2" aria-hidden="true"></i> Centro de control</h2>
				<p class="text-lutvia-texto-suave mt-1">Gestión avanzada de jugadores y manipulación del destino.</p>
			</div>
            <span class="etiqueta bg-lutvia-rosa/15 text-sm px-4 py-2">
                Modo administrador
            </span>
		</header>

		<!-- Configuración global -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8">
			    <h3 class="text-xl font-bold mb-6 flex items-center gap-2"><i class="fa-solid fa-globe text-lutvia-violeta" aria-hidden="true"></i> Configuración global</h3>
			    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <form method="post" action="/api/admin/save-settings" class="space-y-4">
                        <div>
                            <label for="last-lomito-date" class="block text-sm font-bold mb-1">Último Lomito manual</label>
                            <input type="date" id="last-lomito-date" name="last_lomito_date" value={settingsMap.get('last_lomito_date') || ''} class="campo" aria-describedby="last-lomito-help" />
                            <p id="last-lomito-help" class="text-chico text-lutvia-texto-suave mt-1">Al configurarla, esta fecha se usa para el contador de días.</p>
                        </div>
                        <div class="pt-4 border-t border-lutvia-oscuro-16" role="group" aria-labelledby="roll-window-label">
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <p id="roll-window-label" class="block text-sm font-bold">Horario de tirada (GMT-3)</p>
                                <span class={`etiqueta uppercase tracking-wider ${windowStatusLabel.cls}`}>{windowStatusLabel.text}</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label for="roll-window-start" class="block text-xs font-bold mb-1">Abre</label>
                                    <input type="time" id="roll-window-start" name="roll_window_start" required value={schedule.start} class="campo" />
                                </div>
                                <div>
                                    <label for="roll-window-end" class="block text-xs font-bold mb-1">Cierra</label>
                                    <input type="time" id="roll-window-end" name="roll_window_end" required value={schedule.end} class="campo" />
                                </div>
                            </div>
                            <p class="text-chico text-lutvia-texto-suave mt-1">Fuera de este horario nadie puede tirar (salvo <code>lomitotester</code>).</p>
                        </div>
                        <div>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" name="auto_verdict_enabled" value="1" checked={schedule.autoVerdictEnabled} class="w-5 h-5 accent-lutvia-oscuro cursor-pointer" />
                                <span class="text-sm font-bold">Veredicto automático al cierre</span>
                            </label>
                            <p class="text-chico text-lutvia-texto-suave mt-1">Publica el veredicto final en Discord a la hora de cierre. Estado de hoy: <strong class="text-lutvia-oscuro">{autoVerdictLabel}</strong></p>
                        </div>
                        <button class="boton boton-secundario w-full">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Guardar configuración
                        </button>
                    </form>

                    <!-- Acciones rápidas de Discord -->
                    <div class="space-y-4 flex flex-col justify-between border-t md:border-t-0 md:border-l border-lutvia-oscuro-16 pt-6 md:pt-0 md:pl-8">
                        <div>
                            <h4 class="rotulo mb-2">Notificaciones de Discord</h4>
                            <p class="text-xs text-lutvia-texto-suave leading-relaxed mb-4">
                                El veredicto final sale solo a las {schedule.end}. Usá este botón para publicarlo manualmente antes del cierre o para reenviarlo (por ejemplo, si se anuló una tirada).
                            </p>
                        </div>
                        <div class="space-y-3">
                            <!-- El único botón principal de la pantalla -->
                            <button id="publish-verdict-btn" class="boton boton-principal w-full py-3.5">
                                <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Publicar veredicto final
                            </button>
                            <p id="publish-verdict-status" class="text-xs font-semibold justify-center hidden" role="status"></p>
                        </div>
                    </div>
                </div>
            </div>
		</section>

		<!-- Padrón de jugadores -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8">
			    <h3 class="text-xl font-bold mb-6 flex items-center gap-2"><i class="fa-solid fa-users" aria-hidden="true"></i> Padrón de jugadores</h3>
			    <div class="overflow-x-auto rounded-lutvia-radio-chico border border-lutvia-oscuro-16">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-lutvia-gris rotulo">
                                <th class="p-4 font-bold">Jugador</th>
                                <th class="p-4 font-bold">Rol</th>
                                <th class="p-4 font-bold text-right">Acciones peligrosas</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-lutvia-oscuro-16">
                            {allUsers.map((u) => (
                                <tr class="hover:bg-lutvia-oscuro-05 transition-colors">
                                    <td class="p-4">
                                        <div class="flex items-center gap-3">
                                            <!-- Cambiar foto: botón real con un ícono de cámara siempre visible -->
                                            <button type="button" class="relative cursor-pointer rounded-lutvia-pildora" data-avatar-trigger={`avatar-input-${u.id}`} aria-label={`Cambiar la foto de ${u.username}`} title="Cambiar foto de perfil">
                                                <UserAvatar user={u as any} size="md" />
                                                <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-lutvia-pildora bg-lutvia-oscuro text-lutvia-blanco flex items-center justify-center text-mini" aria-hidden="true">
                                                    <i class="fa-solid fa-camera"></i>
                                                </span>
                                            </button>
                                            <input type="file" id={`avatar-input-${u.id}`} data-user-id={u.id} accept="image/*" class="hidden admin-avatar-input" />
                                            {u.avatar_url && !u.avatar_url.includes('api.dicebear.com') && (
                                                <button class="remove-user-avatar-btn boton-icono w-7 h-7 text-xs" data-user-id={u.id} aria-label={`Quitar la foto de ${u.username}`} title="Quitar foto de perfil y volver al avatar por defecto">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            )}
                                            <span class="font-bold text-lutvia-oscuro">{u.username}</span>
                                        </div>
                                    </td>
                                    <td class="p-4">
                                        <span class={`etiqueta uppercase tracking-widest ${u.role === 'admin' ? 'bg-lutvia-rosa/15' : 'bg-lutvia-gris'}`}>
                                            {u.role}
                                        </span>
                                    </td>
                                    <td class="p-4 text-right">
                                        {u.id !== user.id ? (
                                            <div class="flex justify-end gap-2">
                                                <form method="post" action="/api/admin/toggle-role">
                                                    <input type="hidden" name="userId" value={u.id} />
                                                    <input type="hidden" name="role" value={u.role === 'admin' ? 'user' : 'admin'} />
                                                    <button class="boton boton-secundario text-xs px-3 py-1.5">
                                                        <i class="fa-solid fa-rotate" aria-hidden="true"></i> {u.role === 'admin' ? 'Revocar' : 'Ascender'}
                                                    </button>
                                                </form>
                                                <form method="post" action="/api/admin/delete-user" onsubmit={`return confirm('ATENCIÓN: ¿Borrar a ${u.username} y todo su historial? Esta acción no se puede deshacer.')`}>
                                                    <input type="hidden" name="userId" value={u.id} />
                                                    <button class="boton boton-secundario boton-peligro text-xs px-3 py-1.5" aria-label={`Borrar a ${u.username}`} title={`Borrar a ${u.username}`}>
                                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i> Borrar
                                                    </button>
                                                </form>
                                            </div>
                                        ) : (
                                            <span class="rotulo mr-2">Espejo (vos)</span>
                                        )}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
		</section>

		<!-- Carga histórica de puntos -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl mt-8 mb-8 animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8">
			    <h3 class="text-xl font-bold mb-6 flex items-center gap-2"><i class="fa-solid fa-pen-to-square text-lutvia-violeta" aria-hidden="true"></i> Carga histórica de puntos</h3>
                <form method="post" action="/api/admin/manual-points" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <label for="points-user" class="block text-sm font-bold mb-1">Jugador</label>
                            <select id="points-user" name="user_id" class="campo" required>
                                <option value="">Elegí un jugador</option>
                                {allUsers.map(u => (
                                    <option value={u.id}>{u.display_name || u.username}</option>
                                ))}
                            </select>
                        </div>
                        <div>
                            <label for="season-select" class="block text-sm font-bold mb-1">Temporada</label>
                            <select name="season_id" id="season-select" class="campo" required>
                                <option value="">Elegí una temporada</option>
                                {uniqueSeasons.map(s => (
                                    <option value={s}>{formatSeasonName(s)}</option>
                                ))}
                                <option value="custom">Otra temporada (escribila)</option>
                            </select>
                            <div id="custom-season-container" class="hidden mt-2">
                                <label for="custom-season-input" class="sr-only">Otra temporada</label>
                                <input type="text" name="custom_season_id" id="custom-season-input" placeholder="Ej: 2025-invierno" class="campo text-sm" aria-describedby="custom-season-help" />
                                <p id="custom-season-help" class="text-chico text-lutvia-texto-suave mt-1">Formato: AAAA-estación (verano, otoño, invierno, primavera)</p>
                            </div>
                        </div>
                        <div>
                            <label for="points-chore" class="block text-sm font-bold mb-1">Tarea</label>
                            <select id="points-chore" name="chore_code" class="campo" required>
                                <option value="">Elegí una tarea</option>
                                <option value="LA">Lavar (LA)</option>
                                <option value="SA">Sacar (SA)</option>
                                <option value="PO">Poner (PO)</option>
                            </select>
                        </div>
                        <div>
                            <label for="points-total" class="block text-sm font-bold mb-1">Puntos totales</label>
                            <input type="number" id="points-total" name="points" min="0" class="campo" placeholder="Ej: 5" required />
                        </div>
                    </div>
                    <button class="boton boton-secundario w-full mt-2">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Cargar puntos
                    </button>
                </form>
            </div>
		</section>

		<!-- Gestión de exenciones -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl mt-8 mb-8 animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8 border-b border-lutvia-oscuro-16 mb-6">
                <h3 class="text-xl font-bold flex items-center gap-2"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Gestión de exenciones</h3>
                <p class="text-xs text-lutvia-texto-suave mt-1">Configurá qué jugadores están exentos de realizar tareas específicas en cada temporada.</p>
            </div>

            <div class="px-6 md:px-8 pb-8 space-y-8">
                <!-- Nueva exención: bloque gris dentro de la tarjeta blanca -->
                <form method="post" action="/api/admin/add-exemption" class="space-y-4 bg-lutvia-gris p-5 rounded-lutvia-radio">
                    <h4 class="rotulo mb-2">Crear nueva exención</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label for="exemption-user" class="block text-sm font-bold mb-1">Jugador</label>
                            <select id="exemption-user" name="user_id" class="campo text-sm" required>
                                <option value="">Elegí un jugador</option>
                                {allUsers.map(u => (
                                    <option value={u.id}>{u.display_name || u.username}</option>
                                ))}
                            </select>
                        </div>
                        <div>
                            <label for="exemption-season-select" class="block text-sm font-bold mb-1">Temporada</label>
                            <select name="season_id" id="exemption-season-select" class="campo text-sm" required>
                                <option value="">Elegí una temporada</option>
                                {uniqueSeasons.map(s => (
                                    <option value={s}>{formatSeasonName(s)}</option>
                                ))}
                                <option value="custom">Otra temporada (escribila)</option>
                            </select>
                            <div id="exemption-custom-season-container" class="hidden mt-2">
                                <label for="exemption-custom-season-input" class="sr-only">Otra temporada</label>
                                <input type="text" name="custom_season_id" id="exemption-custom-season-input" placeholder="Ej: 2026-otoño" class="campo text-sm" aria-describedby="exemption-custom-season-help" />
                                <p id="exemption-custom-season-help" class="text-chico text-lutvia-texto-suave mt-1">Formato: AAAA-estación (verano, otoño, invierno, primavera)</p>
                            </div>
                        </div>
                        <div>
                            <label for="exemption-chore" class="block text-sm font-bold mb-1">Tarea exenta</label>
                            <select id="exemption-chore" name="chore_code" class="campo text-sm" required>
                                <option value="">Elegí una tarea</option>
                                <option value="LA">Lavar (LA)</option>
                                <option value="SA">Sacar (SA)</option>
                                <option value="PO">Poner (PO)</option>
                            </select>
                        </div>
                    </div>
                    <button class="boton boton-secundario mt-2 text-sm">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Asignar exención
                    </button>
                </form>

                <!-- Exenciones registradas -->
                <div>
                    <h4 class="rotulo mb-4">Exenciones registradas</h4>
                    {allExemptions.length === 0 ? (
                        <p class="text-sm text-lutvia-texto-suave italic py-4">No hay exenciones cargadas en la base de datos.</p>
                    ) : (
                        <div class="overflow-x-auto rounded-lutvia-radio-chico border border-lutvia-oscuro-16">
                            <table class="w-full text-left border-collapse whitespace-nowrap text-sm">
                                <thead>
                                    <tr class="bg-lutvia-gris rotulo">
                                        <th class="p-4 font-bold">Temporada</th>
                                        <th class="p-4 font-bold">Jugador</th>
                                        <th class="p-4 font-bold">Tarea exenta</th>
                                        <th class="p-4 font-bold text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-lutvia-oscuro-16">
                                    {allExemptions.map((ex: any) => {
                                        const exChore = chores.find(c => c.code === ex.chore_code);
                                        const choreLabel = ex.chore_code === 'LA' ? 'lavar' : ex.chore_code === 'SA' ? 'sacar' : 'poner';
                                        return (
                                            <tr class="hover:bg-lutvia-oscuro-05 transition-colors">
                                                <td class="p-4 font-bold">{formatSeasonName(ex.season_id)}</td>
                                                <td class="p-4">
                                                    <div class="flex items-center gap-2 font-bold text-lutvia-oscuro">
                                                        <UserAvatar user={{ username: ex.username, display_name: ex.display_name, avatar_url: ex.avatar_url }} size="sm" />
                                                        {ex.display_name}
                                                    </div>
                                                </td>
                                                <td class="p-4">
                                                    <span class={`etiqueta ${choreStyles[ex.chore_code]?.etiqueta ?? 'bg-lutvia-gris'}`}>
                                                        <span aria-hidden="true">{exChore?.emoji}</span> Exento de {choreLabel} ({ex.chore_code})
                                                    </span>
                                                </td>
                                                <td class="p-4 text-right">
                                                    <form method="post" action="/api/admin/remove-exemption" onsubmit={`return confirm('¿Eliminar la exención de ${ex.display_name} para ${formatSeasonName(ex.season_id)}?')`}>
                                                        <input type="hidden" name="id" value={ex.id} />
                                                        <button class="boton boton-secundario boton-peligro text-xs px-3 py-1.5">
                                                            <i class="fa-solid fa-trash" aria-hidden="true"></i> Eliminar
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        );
                                    })}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>
		</section>

		<!-- Últimas 50 tiradas -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8">
                <div class="flex items-center justify-between mb-6">
			        <h3 class="text-xl font-bold flex items-center gap-2"><i class="fa-solid fa-dice" aria-hidden="true"></i> Últimas 50 tiradas</h3>
                </div>
			    <div class="overflow-x-auto rounded-lutvia-radio-chico border border-lutvia-oscuro-16">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-lutvia-gris rotulo">
                                <th class="p-4 font-bold">Fecha</th>
                                <th class="p-4 font-bold">Jugador</th>
                                <th class="p-4 font-bold">Dados</th>
                                <th class="p-4 font-bold text-right">Justicia</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-lutvia-oscuro-16">
                            {recentRolls.length === 0 && (
                                <tr><td colspan="4" class="p-8 text-center text-lutvia-texto-suave font-bold">La historia está en blanco.</td></tr>
                            )}
                            {recentRolls.map((r) => (
                                <tr class="hover:bg-lutvia-oscuro-05 transition-colors">
                                    <td class="p-4 text-sm tabular-nums text-lutvia-texto-suave">{formatDate(r.date as string)}</td>
                                    <td class="p-4">
                                        <div class="flex items-center gap-2 font-bold text-lutvia-oscuro">
                                            <UserAvatar user={{ username: r.username as string, display_name: r.display_name as string, avatar_url: r.avatar_url as string }} size="sm" />
                                            {r.display_name}
                                        </div>
                                    </td>
                                    <td class="p-4">
                                        <DiceDisplay die1={r.die1 as number} die2={r.die2 as number} die3={r.die3 as number} die4={r.die4 as number} size="md" />
                                    </td>
                                    <td class="p-4 text-right">
                                        <form method="post" action="/api/admin/delete-roll" onsubmit={`return confirm('¿Alterar el destino y anular la tirada de ${r.username}?')`}>
                                            <input type="hidden" name="rollId" value={r.id} />
                                            <button class="boton boton-secundario boton-peligro text-xs px-3 py-1.5">
                                                <i class="fa-solid fa-ban" aria-hidden="true"></i> Anular
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
		</section>

		<!-- Cambios de contraseña -->
		<section class="bg-lutvia-blanco p-1 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <div class="p-6 md:p-8">
                <h3 class="text-xl font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-key text-lutvia-violeta" aria-hidden="true"></i> Cambios de contraseña</h3>
                <p class="text-xs text-lutvia-texto-suave mb-6">Registro de restablecimientos de contraseña hechos desde /reset. Cualquiera puede resetear libremente; acá queda constancia por las dudas.</p>
			    <div class="overflow-x-auto rounded-lutvia-radio-chico border border-lutvia-oscuro-16">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-lutvia-gris rotulo">
                                <th class="p-4 font-bold">Fecha y hora</th>
                                <th class="p-4 font-bold">Usuario</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-lutvia-oscuro-16">
                            {recentResets.length === 0 && (
                                <tr><td colspan="2" class="p-8 text-center text-lutvia-texto-suave font-bold">Nadie cambió su contraseña todavía.</td></tr>
                            )}
                            {recentResets.map((r: any) => (
                                <tr class="hover:bg-lutvia-oscuro-05 transition-colors">
                                    <td class="p-4 text-sm tabular-nums text-lutvia-texto-suave">{formatResetDate(r.created_at)}</td>
                                    <td class="p-4 font-bold text-lutvia-oscuro">{r.username}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
		</section>
	</div>

	<script>
		document.addEventListener('astro:page-load', () => {
			// Manual points custom season handler
			const seasonSelect = document.getElementById('season-select') as HTMLSelectElement;
			const customSeasonContainer = document.getElementById('custom-season-container');
			const customSeasonInput = document.getElementById('custom-season-input') as HTMLInputElement;

			seasonSelect?.addEventListener('change', () => {
				if (seasonSelect.value === 'custom') {
					customSeasonContainer?.classList.remove('hidden');
					customSeasonInput?.setAttribute('required', 'true');
				} else {
					customSeasonContainer?.classList.add('hidden');
					customSeasonInput?.removeAttribute('required');
				}
			});

			// Exemptions custom season handler
			const exemptionSeasonSelect = document.getElementById('exemption-season-select') as HTMLSelectElement;
			const exemptionCustomSeasonContainer = document.getElementById('exemption-custom-season-container');
			const exemptionCustomSeasonInput = document.getElementById('exemption-custom-season-input') as HTMLInputElement;

			exemptionSeasonSelect?.addEventListener('change', () => {
				if (exemptionSeasonSelect.value === 'custom') {
					exemptionCustomSeasonContainer?.classList.remove('hidden');
					exemptionCustomSeasonInput?.setAttribute('required', 'true');
				} else {
					exemptionCustomSeasonContainer?.classList.add('hidden');
					exemptionCustomSeasonInput?.removeAttribute('required');
				}
			});

			// El botón del avatar abre el selector de archivo de ese jugador
			document.querySelectorAll<HTMLElement>('[data-avatar-trigger]').forEach(trigger => {
				trigger.addEventListener('click', () => {
					document.getElementById(trigger.dataset.avatarTrigger || '')?.click();
				});
			});

			// Admin user avatar quick update handler
			const adminAvatarInputs = document.querySelectorAll('.admin-avatar-input');
			adminAvatarInputs.forEach(inputEl => {
				inputEl.addEventListener('change', async (e) => {
					const input = e.target as HTMLInputElement;
					const file = input.files?.[0];
					if (!file) return;

					const userId = input.getAttribute('data-user-id');
					if (!userId) return;

					if (!file.type.startsWith('image/')) {
						alert("Elegí una imagen válida.");
						return;
					}

					try {
						const base64Image = await compressImage(file, 256, 256, 0.8);
						const response = await fetch('/api/admin/update-user-avatar', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ userId, avatar: base64Image })
						});

						if (!response.ok) {
							throw new Error(await response.text());
						}
						window.location.reload();
					} catch (err: any) {
						alert(err.message || "Ocurrió un error al subir la imagen");
					}
				});
			});

			// Admin user avatar remove handler
			const removeAvatarBtns = document.querySelectorAll('.remove-user-avatar-btn');
			removeAvatarBtns.forEach(btn => {
				btn.addEventListener('click', async (e) => {
					const button = btn as HTMLButtonElement;
					const userId = button.getAttribute('data-user-id');
					if (!userId) return;

					if (confirm("¿Seguro que querés eliminar la foto de este usuario y restaurar el avatar por defecto?")) {
						try {
							const response = await fetch('/api/admin/update-user-avatar', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ userId, removeAvatar: true })
							});

							if (!response.ok) {
								throw new Error(await response.text());
							}
							window.location.reload();
						} catch (err: any) {
							alert(err.message || "Ocurrió un error al eliminar la imagen");
						}
					}
				});
			});

			// Publish manual verdict to Discord
			const publishVerdictBtn = document.getElementById('publish-verdict-btn');
			const publishVerdictStatus = document.getElementById('publish-verdict-status');

			// El mensaje va en gris oscuro; el ícono marca el resultado (el rosa, solo en el ícono de error)
			const setPublishStatus = (text: string, tone: 'muted' | 'ok' | 'error') => {
				if (!publishVerdictStatus) return;
				const icon = tone === 'ok' ? 'fa-circle-check' : tone === 'error' ? 'fa-triangle-exclamation text-lutvia-rosa' : 'fa-spinner fa-spin';
				const color = tone === 'muted' ? 'text-lutvia-texto-suave' : 'text-lutvia-oscuro';
				publishVerdictStatus.className = `flex items-center justify-center gap-1.5 text-xs font-semibold text-center ${color}`;
				publishVerdictStatus.innerHTML = `<i class="fa-solid ${icon}" aria-hidden="true"></i>`;
				publishVerdictStatus.append(document.createTextNode(text));
			};

			publishVerdictBtn?.addEventListener('click', async () => {
				if (!confirm('¿Confirmás la publicación del veredicto final en Discord?')) {
					return;
				}

				if (publishVerdictBtn instanceof HTMLButtonElement) {
					publishVerdictBtn.disabled = true;
				}
				setPublishStatus('Enviando veredicto...', 'muted');

				try {
					const res = await fetch('/api/admin/publish-verdict', {
						method: 'POST'
					});
					const data = await res.json();

					if (res.ok && data.success) {
						setPublishStatus('¡Veredicto publicado en Discord!', 'ok');
					} else {
						setPublishStatus(`Error: ${data.error || 'No se pudo publicar'}`, 'error');
					}
				} catch (err: any) {
					setPublishStatus(`Error: ${err.message || 'Error de conexión'}`, 'error');
				} finally {
					if (publishVerdictBtn instanceof HTMLButtonElement) {
						publishVerdictBtn.disabled = false;
					}
				}
			});
		});

		// Comprime la imagen usando un Canvas antes de enviarla
		function compressImage(file: File, maxWidth: number, maxHeight: number, quality: number): Promise<string> {
			return new Promise((resolve, reject) => {
				const reader = new FileReader();
				reader.readAsDataURL(file);
				reader.onload = (event) => {
					const img = new Image();
					img.src = event.target?.result as string;
					img.onload = () => {
						const canvas = document.createElement('canvas');
						let width = img.width;
						let height = img.height;

						if (width > height) {
							if (width > maxWidth) {
								height = Math.round(height * maxWidth / width);
								width = maxWidth;
							}
						} else {
							if (height > maxHeight) {
								width = Math.round(width * maxHeight / height);
								height = maxHeight;
							}
						}

						canvas.width = width;
						canvas.height = height;

						const ctx = canvas.getContext('2d');
						if (!ctx) {
							reject(new Error("No se pudo obtener el contexto del canvas"));
							return;
						}
						
						ctx.drawImage(img, 0, 0, width, height);
						resolve(canvas.toDataURL('image/jpeg', quality));
					};
					img.onerror = (err) => reject(err);
				};
				reader.onerror = (err) => reject(err);
			});
		}
	</script>
</Layout>
