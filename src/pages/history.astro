---
import Layout from '../layouts/Layout.astro';
import db from '../db/index.js';
import UserAvatar from '../components/UserAvatar.astro';
import DiceDisplay from '../components/DiceDisplay.astro';
import StatsTable from '../components/StatsTable.astro';
import { formatDate } from '../utils/date.js';

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}

// Get all rolls ordered by date descending, then by die scores ascending
const allRollsRes = await db.execute(`
    SELECT r.*, u.username, u.display_name, u.avatar_url 
    FROM roll r
    JOIN user u ON r.user_id = u.id
    ORDER BY r.date DESC, r.die1 ASC, r.die2 ASC, r.die3 ASC, r.die4 ASC
`);

// Group by date
const groupedRolls: Record<string, typeof allRollsRes.rows> = {};
for (const row of allRollsRes.rows) {
    const date = row.date as string;
    if (!groupedRolls[date]) {
        groupedRolls[date] = [];
    }
    groupedRolls[date].push(row);
}

import { getSeasonId, getPreviousSeasons, formatSeasonName, calculateSeasonPoints, calculateYearPoints, getExemptionsForSeason, getPastSeasonsWithData, getSeasonDateRange } from '../utils/season.js';
import { assignDailyChores, chores, choreStyles } from '../utils/chores.js';

const dates = Object.keys(groupedRolls).sort((a, b) => b.localeCompare(a));

// Calculate unique seasons present in history dates and load their exemptions
const uniqueSeasonsInHistory = Array.from(new Set(dates.map(date => getSeasonId(date))));
const exemptionsMap = new Map<string, any[]>();
for (const sId of uniqueSeasonsInHistory) {
    exemptionsMap.set(sId, await getExemptionsForSeason(db, sId));
}

const historyData = dates.map(date => {
    const seasonId = getSeasonId(date);
    const seasonExemptions = exemptionsMap.get(seasonId) || [];
    
    const { sortedRolls, rollChoreMap, lomitoActivated, lomitoPlayers } = assignDailyChores(groupedRolls[date], seasonExemptions);
    
    return {
        date,
        rolls: sortedRolls,
        choreMap: rollChoreMap,
        lomitoActivated,
        lomitoPlayers,
        exemptions: seasonExemptions
    };
});

// Helper to get the Monday of the week for a given date YYYY-MM-DD
function getMonday(dateStr: string) {
    const d = new Date(dateStr + 'T12:00:00');
    const day = d.getDay();
    const diff = d.getDate() - day + (day === 0 ? -6 : 1); // adjust when day is sunday (0)
    const monday = new Date(d.setDate(diff));
    return monday.toISOString().split('T')[0];
}

// Helper to format the week range
function formatWeekRange(mondayStr: string) {
    if (!mondayStr) return "";
    const mon = new Date(mondayStr + 'T12:00:00');
    const sun = new Date(mon);
    sun.setDate(sun.getDate() + 6);
    
    const format = (d: Date) => {
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        return `${day}/${month}/${d.getFullYear()}`;
    };
    return `Semana del ${format(mon)} al ${format(sun)}`;
}

// Group historyData by calendar week starting on Monday
const weeksMap = new Map<string, typeof historyData>();
for (const item of historyData) {
    const monday = getMonday(item.date);
    if (!weeksMap.has(monday)) {
        weeksMap.set(monday, []);
    }
    weeksMap.get(monday)!.push(item);
}

// Sorted week Mondays descending
const weekMondays = Array.from(weeksMap.keys()).sort((a, b) => b.localeCompare(a));

// Get selected week from URL search params, default to most recent week
const url = new URL(Astro.request.url);
const selectedWeek = url.searchParams.get("week") || weekMondays[0] || "";

// Paginated rolls for the selected week
const paginatedHistoryData = selectedWeek ? (weeksMap.get(selectedWeek) || []) : [];

// Find previous and next week Mondays for pagination controls
const selectedWeekIndex = weekMondays.indexOf(selectedWeek);
const nextWeekMonday = selectedWeekIndex > 0 ? weekMondays[selectedWeekIndex - 1] : null; // Index decreases -> newer week
const prevWeekMonday = selectedWeekIndex !== -1 && selectedWeekIndex < weekMondays.length - 1 ? weekMondays[selectedWeekIndex + 1] : null; // Index increases -> older week

// Calculate current date in GMT-3 to obtain current season
const today = new Date();
today.setHours(today.getHours() - 3);
const todayStr = today.toISOString().split('T')[0];
const currentSeasonId = getSeasonId(todayStr);

const currentSeasonStats = await calculateSeasonPoints(db, currentSeasonId);

// Sort by total points descending, then alphabetically by display_name (falling back to username)
const sortStats = (stats: any[]) => {
    return [...stats].sort((a, b) => {
        const totalA = (a.scores.LA || 0) + (a.scores.SA || 0) + (a.scores.PO || 0);
        const totalB = (b.scores.LA || 0) + (b.scores.SA || 0) + (b.scores.PO || 0);
        if (totalB !== totalA) {
            return totalB - totalA;
        }
        const nameA = String(a.display_name || a.username);
        const nameB = String(b.display_name || b.username);
        return nameA.localeCompare(nameB);
    });
};

const sortedCurrentStats = sortStats(currentSeasonStats);
const currentSeasonRange = getSeasonDateRange(currentSeasonId);

// Past seasons with data (newest first) for the "Temporada Anterior" selector.
// Falls back to the immediate previous season so the card always has something to show.
const pastSeasonIds = await getPastSeasonsWithData(db, currentSeasonId);
if (pastSeasonIds.length === 0) pastSeasonIds.push(getPreviousSeasons(currentSeasonId, 1)[1]);
const pastSeasons = [];
for (const seasonId of pastSeasonIds) {
    pastSeasons.push({
        id: seasonId,
        name: formatSeasonName(seasonId),
        range: getSeasonDateRange(seasonId),
        stats: sortStats(await calculateSeasonPoints(db, seasonId)),
        exemptions: await getExemptionsForSeason(db, seasonId),
    });
}

const currentYear = today.getFullYear().toString();
const yearStats = await calculateYearPoints(db, currentYear);
const sortedYearStats = sortStats(yearStats);

// Fetch exemptions for the current season
const currentSeasonExemptions = await getExemptionsForSeason(db, currentSeasonId);

const choreVerb = (code: string) => code === 'LA' ? 'lavar' : code === 'SA' ? 'sacar' : 'poner';
---

<Layout>
    <div class="space-y-10 animate-in fade-in">

        <header class="mb-10 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4 animate-in fade-in slide-in-from-bottom-4">
            <div>
                <h2 class="text-3xl md:text-4xl font-black tracking-tight text-lutvia-oscuro">Archivos POSALANA</h2>
                <p class="text-lutvia-texto-suave mt-2">El registro inmutable de la suerte pasada.</p>
            </div>
            <span class="etiqueta bg-lutvia-blanco text-sm px-4 py-2">
                <i class="fa-solid fa-database" aria-hidden="true"></i> {dates.length} días registrados
            </span>
        </header>

        <!-- Resumen de temporadas -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 animate-in fade-in slide-in-from-bottom-4">
            <!-- Temporada actual -->
            <div class="bg-lutvia-blanco p-6 md:p-8 rounded-3xl shadow-xl hover-card-lift">
                <div class="flex flex-col items-start gap-3 mb-6">
                    <h3 class="text-xl font-black flex items-center gap-2.5 text-lutvia-oscuro">
                        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                        Temporada actual
                    </h3>
                    <span class="etiqueta bg-lutvia-cyan/15 text-sm px-4 py-1.5">
                        {formatSeasonName(currentSeasonId)}
                    </span>
                </div>

                <p class="text-xs text-lutvia-texto-suave font-semibold -mt-3 mb-4 tabular-nums">{currentSeasonRange.start} — {currentSeasonRange.end}</p>
                {sortedCurrentStats.length === 0 ? (
                    <p class="text-sm text-lutvia-texto-suave py-8 italic text-center">Sin datos registrados en esta temporada.</p>
                ) : (
                    <StatsTable stats={sortedCurrentStats} />
                )}

                {currentSeasonExemptions.length > 0 && (
                    <div class="mt-6 pt-6 border-t border-lutvia-oscuro-16">
                        <h4 class="rotulo mb-3 flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Exenciones de la temporada
                        </h4>
                        <div class="flex flex-wrap gap-2">
                            {currentSeasonExemptions.map(ex => {
                                const exChore = chores.find(c => c.code === ex.chore_code);
                                return (
                                    <span class={`etiqueta gap-2 pl-1 pr-3 py-1 ${choreStyles[ex.chore_code]?.etiqueta ?? 'bg-lutvia-gris'}`}>
                                        <UserAvatar user={{ username: ex.username, display_name: ex.display_name, avatar_url: ex.avatar_url }} size="sm" />
                                        {ex.display_name}
                                        <span class="font-semibold"><span aria-hidden="true">{exChore?.emoji}</span> Exento de {choreVerb(ex.chore_code)}</span>
                                    </span>
                                );
                            })}
                        </div>
                    </div>
                )}
            </div>

            <!-- Temporadas anteriores (con selector) -->
            <div class="bg-lutvia-blanco p-6 md:p-8 rounded-3xl shadow-xl hover-card-lift">
                <div class="flex flex-col items-start gap-3 mb-6 relative z-20">
                    <h3 class="text-xl font-black flex items-center gap-2.5 text-lutvia-oscuro">
                        <i class="fa-solid fa-clock-rotate-left text-lutvia-violeta" aria-hidden="true"></i>
                        Temporadas anteriores
                    </h3>
                    <div id="past-season-dropdown" class="relative">
                        <button
                            type="button"
                            id="past-season-button"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls="past-season-list"
                            class="boton boton-secundario text-sm py-1.5 pl-3.5 pr-4"
                        >
                            <i class="fa-solid fa-chevron-down text-xs transition-transform" data-chevron aria-hidden="true"></i>
                            <span id="past-season-label">{pastSeasons[0]?.name}</span>
                        </button>
                        <!-- Lista flotante: blanca con borde oscuro, sin sombra (queda sobre la tarjeta blanca) -->
                        <ul
                            id="past-season-list"
                            role="listbox"
                            aria-label="Elegí una temporada"
                            tabindex="-1"
                            class="hidden absolute left-0 top-full mt-2 min-w-full w-max max-h-64 overflow-y-auto bg-lutvia-blanco border-2 border-lutvia-oscuro rounded-lutvia-radio p-1.5 z-30 animate-in fade-in zoom-in-95"
                        >
                            {pastSeasons.map((season, i) => (
                                <li
                                    role="option"
                                    data-season-option={season.id}
                                    aria-selected={i === 0 ? 'true' : 'false'}
                                    class="flex items-center justify-between gap-4 px-3.5 py-2 rounded-lutvia-radio-chico text-sm font-bold text-lutvia-oscuro cursor-pointer hover:bg-lutvia-gris data-[active=true]:bg-lutvia-gris aria-selected:font-black transition-colors"
                                >
                                    <span>{season.name}</span>
                                    <i class="fa-solid fa-check text-xs opacity-0" data-check aria-hidden="true"></i>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                {pastSeasons.map((season, i) => (
                    <div data-past-season={season.id} class:list={[{ hidden: i !== 0 }]}>
                        <p class="text-xs text-lutvia-texto-suave font-semibold -mt-3 mb-4 tabular-nums">{season.range.start} — {season.range.end}</p>
                        {season.stats.length === 0 ? (
                            <p class="text-sm text-lutvia-texto-suave py-8 italic text-center">Sin datos registrados en esta temporada.</p>
                        ) : (
                            <StatsTable stats={season.stats} />
                        )}

                        {season.exemptions.length > 0 && (
                            <div class="mt-6 pt-6 border-t border-lutvia-oscuro-16">
                                <h4 class="rotulo mb-3 flex items-center gap-1.5">
                                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Exenciones de la temporada
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    {season.exemptions.map(ex => {
                                        const exChore = chores.find(c => c.code === ex.chore_code);
                                        return (
                                            <span class={`etiqueta gap-2 pl-1 pr-3 py-1 ${choreStyles[ex.chore_code]?.etiqueta ?? 'bg-lutvia-gris'}`}>
                                                <UserAvatar user={{ username: ex.username, display_name: ex.display_name, avatar_url: ex.avatar_url }} size="sm" />
                                                {ex.display_name}
                                                <span class="font-semibold"><span aria-hidden="true">{exChore?.emoji}</span> Exento de {choreVerb(ex.chore_code)}</span>
                                            </span>
                                        );
                                    })}
                                </div>
                            </div>
                        )}
                    </div>
                ))}
            </div>
        </section>

        <!-- Tabla global del año -->
        <div class="bg-lutvia-blanco p-6 md:p-8 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 hover-card-lift">
            <h3 class="text-xl font-black mb-6 flex items-center gap-2.5 text-lutvia-oscuro">
                <i class="fa-solid fa-earth-americas text-lutvia-rosa" aria-hidden="true"></i>
                Tabla global del año: <span class="tabular-nums">{currentYear}</span>
            </h3>

            {sortedYearStats.length === 0 ? (
                <p class="text-sm text-lutvia-texto-suave py-8 italic text-center">Sin datos registrados en este año.</p>
            ) : (
                <StatsTable stats={sortedYearStats} sortable={true} />
            )}
        </div>

        {dates.length === 0 ? (
            <div class="py-20 text-center border-2 border-dashed border-lutvia-oscuro-16 rounded-lutvia-radio">
                <div class="text-5xl mb-4 text-lutvia-texto-suave"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></div>
                <p class="text-lutvia-texto-suave font-medium text-lg">Los archivos están vacíos.</p>
            </div>
        ) : (
            <div id="historial-seccion" class="space-y-8 scroll-mt-24 animate-in fade-in slide-in-from-bottom-4">
                <!-- Selector de semanas (paginación) -->
                <div class="flex flex-col sm:flex-row items-center justify-between bg-lutvia-blanco p-4 rounded-lutvia-radio gap-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-calendar-week text-lg" aria-hidden="true"></i>
                        <span id="week-range-label" class="font-black text-lutvia-oscuro text-sm tracking-tight tabular-nums" aria-live="polite">{formatWeekRange(selectedWeek)}</span>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
                        <a id="prev-week-btn" href={prevWeekMonday ? `?week=${prevWeekMonday}#historial-seccion` : undefined} aria-disabled={prevWeekMonday ? undefined : 'true'} class="boton boton-secundario text-xs px-4 py-2">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Semana anterior
                        </a>
                        <a id="next-week-btn" href={nextWeekMonday ? `?week=${nextWeekMonday}#historial-seccion` : undefined} aria-disabled={nextWeekMonday ? undefined : 'true'} class="boton boton-secundario text-xs px-4 py-2">
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Semana siguiente
                        </a>
                    </div>
                </div>

                <div id="weeks-container" class="space-y-12">
                    {weekMondays.map((monday) => {
                        const weekData = weeksMap.get(monday) || [];
                        const isSelected = monday === selectedWeek;
                        return (
                            <div data-week={monday} data-week-range={formatWeekRange(monday)} class={`week-container space-y-12 animate-in fade-in slide-in-from-bottom-2 ${isSelected ? '' : 'hidden'}`}>
                                {weekData.map((data, dateIndex) => (
                                    <section class="relative">
                                        {/* Línea de la línea de tiempo */}
                                        {dateIndex !== weekData.length - 1 && (
                                            <div class="absolute left-[1.3rem] md:left-[1.8rem] top-14 bottom-[-3rem] w-px bg-lutvia-oscuro-16 z-0" aria-hidden="true"></div>
                                        )}

                                        {/* Fecha: círculo cyan con el ícono en gris oscuro (5.53) */}
                                        <div class="flex items-center gap-4 mb-6 relative z-10">
                                            <div class="w-10 h-10 md:w-14 md:h-14 rounded-lutvia-pildora bg-lutvia-cyan text-lutvia-oscuro flex items-center justify-center" aria-hidden="true">
                                                <i class="fa-solid fa-calendar-day"></i>
                                            </div>
                                            <h3 class="text-xl md:text-2xl font-black text-lutvia-oscuro tabular-nums">{formatDate(data.date)}</h3>
                                        </div>

                                        {/* Cláusula Lomito del día: bloque blanco con acento violeta y texto oscuro */}
                                        {data.lomitoActivated && (
                                            <div class="pl-6 md:pl-10 mb-4 relative z-10">
                                                <p class="bg-lutvia-blanco border-l-4 border-lutvia-violeta px-4 py-2 rounded-lutvia-radio-chico inline-block text-lutvia-oscuro font-bold text-sm">
                                                    <span aria-hidden="true">🥪</span> Cláusula Lomito activada por {data.lomitoPlayers.join(" y ")}
                                                </p>
                                            </div>
                                        )}

                                        {/* Tiradas del día */}
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6 md:pl-10 relative z-10">
                                            {data.rolls.map((roll) => {
                                                const chore = data.choreMap.get(roll.id);
                                                const isSafe = chore.code === "NA";
                                                const userExemptions = (data.exemptions || []).filter(e => String(e.user_id) === String(roll.user_id));
                                                return (
                                                    <div class="flex flex-row items-center justify-between gap-3 p-4 rounded-lutvia-radio-chico bg-lutvia-blanco">
                                                        <div class="flex flex-wrap items-center gap-2.5 min-w-0">
                                                            <UserAvatar user={{ username: roll.username as string, display_name: roll.display_name as string, avatar_url: roll.avatar_url as string }} size="md" />
                                                            <span class="font-bold text-lutvia-oscuro">{roll.display_name}</span>
                                                            {userExemptions.map(ex => {
                                                                const targetChore = chores.find(c => c.code === ex.chore_code);
                                                                const choreLabel = targetChore ? targetChore.label.split(' ')[0] : ex.chore_code;
                                                                return (
                                                                    <span class="etiqueta bg-lutvia-violeta/15 uppercase tracking-wider" title={`Exento de: ${targetChore ? targetChore.label : ex.chore_code}`}>
                                                                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {choreLabel}
                                                                    </span>
                                                                )
                                                            })}
                                                        </div>

                                                        <div class="flex items-center gap-4 shrink-0">
                                                            <div class="hidden sm:flex items-center">
                                                                <DiceDisplay die1={roll.die1 as number} die2={roll.die2 as number} die3={roll.die3 as number} die4={roll.die4 as number} size="sm" isSafe={isSafe} />
                                                            </div>
                                                            {/* El estado va en texto: la etiqueta de tarea dice el código y, si zafó, "Te salvás" */}
                                                            <span class={`etiqueta tracking-widest ${choreStyles[chore.code]?.etiqueta ?? 'bg-lutvia-gris'}`} title={chore.label}>
                                                                <span aria-hidden="true">{chore.emoji}</span> {chore.code}<span class="sr-only"> · {chore.label}</span>{isSafe && <span class="tracking-normal"> · Te salvás</span>}
                                                            </span>
                                                        </div>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </section>
                                ))}
                            </div>
                        );
                    })}
                </div>
            </div>
        )}
    </div>

	<script>
		document.addEventListener('astro:page-load', () => {
			// Past season dropdown: toggles the pre-rendered season tables without reloading
			const seasonDropdown = document.getElementById('past-season-dropdown');
			const seasonButton = document.getElementById('past-season-button');
			const seasonList = document.getElementById('past-season-list');
			const seasonLabel = document.getElementById('past-season-label');
			const seasonOptions = Array.from(document.querySelectorAll<HTMLElement>('[data-season-option]'));
			let activeIndex = 0;

			const syncChecks = () => {
				seasonOptions.forEach(opt => {
					opt.querySelector('[data-check]')?.classList.toggle('opacity-0', opt.getAttribute('aria-selected') !== 'true');
				});
			};

			const setActive = (index: number) => {
				activeIndex = (index + seasonOptions.length) % seasonOptions.length;
				seasonOptions.forEach((opt, i) => { opt.dataset.active = String(i === activeIndex); });
				seasonOptions[activeIndex]?.scrollIntoView({ block: 'nearest' });
			};

			const openList = (open: boolean) => {
				if (!seasonList || !seasonButton) return;
				seasonList.classList.toggle('hidden', !open);
				seasonButton.setAttribute('aria-expanded', String(open));
				seasonButton.querySelector('[data-chevron]')?.classList.toggle('rotate-180', open);
				if (open) {
					setActive(Math.max(0, seasonOptions.findIndex(o => o.getAttribute('aria-selected') === 'true')));
					seasonList.focus();
				}
			};

			const selectSeason = (opt: HTMLElement) => {
				const id = opt.dataset.seasonOption;
				seasonOptions.forEach(o => o.setAttribute('aria-selected', String(o === opt)));
				if (seasonLabel) seasonLabel.textContent = opt.textContent?.trim() || '';
				document.querySelectorAll<HTMLElement>('[data-past-season]').forEach(el => {
					el.classList.toggle('hidden', el.dataset.pastSeason !== id);
				});
				syncChecks();
				openList(false);
				seasonButton?.focus();
			};

			syncChecks();

			seasonButton?.addEventListener('click', () => {
				openList(seasonList?.classList.contains('hidden') ?? false);
			});

			seasonButton?.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					openList(true);
				}
			});

			seasonOptions.forEach(opt => {
				opt.addEventListener('click', () => selectSeason(opt));
				opt.addEventListener('mousemove', () => setActive(seasonOptions.indexOf(opt)));
			});

			seasonList?.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
				else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
				else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSeason(seasonOptions[activeIndex]); }
				else if (e.key === 'Escape' || e.key === 'Tab') { openList(false); if (e.key === 'Escape') seasonButton?.focus(); }
			});

			document.addEventListener('click', (e) => {
				if (seasonDropdown && !seasonDropdown.contains(e.target as Node)) openList(false);
			});

			// Sorting interactive functionality for the yearly global table
			const table = document.getElementById('global-table');
			const headers = table?.querySelectorAll('thead th[data-sort]');
			const tbody = table?.querySelector('tbody');

			let currentSortColumn = '';
			let currentSortOrder = 'asc';

			headers?.forEach(header => {
				header.addEventListener('click', () => {
					const sortKey = header.getAttribute('data-sort');
					if (!sortKey || !tbody) return;

					const order = (currentSortColumn === sortKey && currentSortOrder === 'asc') ? 'desc' : 'asc';
					currentSortColumn = sortKey;
					currentSortOrder = order;

					const rows = Array.from(tbody.querySelectorAll('tr'));
					rows.sort((rowA, rowB) => {
						const valA = getRowValue(rowA, sortKey);
						const valB = getRowValue(rowB, sortKey);

						if (typeof valA === 'number' && typeof valB === 'number') {
							return order === 'asc' ? valA - valB : valB - valA;
						} else {
							return order === 'asc'
								? String(valA).localeCompare(String(valB))
								: String(valB).localeCompare(String(valA));
						}
					});

					tbody.innerHTML = '';
					rows.forEach(row => tbody.appendChild(row));

					updateHeaderIndicators(headers, sortKey, order);
				});
			});

			function getRowValue(row: HTMLTableRowElement, key: string) {
				const cell = row.querySelector(`[data-val-${key}]`);
				if (!cell) return '';
				const rawVal = cell.getAttribute(`data-val-${key}`);
				const num = Number(rawVal);
				return isNaN(num) ? rawVal || '' : num;
			}

			function updateHeaderIndicators(headers: NodeListOf<Element>, activeKey: string, order: string) {
				headers.forEach(h => {
					const key = h.getAttribute('data-sort');
					const icon = h.querySelector('i');
					const isActive = key === activeKey;
					h.setAttribute('aria-sort', isActive ? (order === 'asc' ? 'ascending' : 'descending') : 'none');
					if (icon) {
						// El ícono de la columna activa va en rosa (indicador no textual, 4.22)
						icon.className = isActive
							? `fa-solid ${order === 'asc' ? 'fa-sort-up' : 'fa-sort-down'} text-lutvia-rosa`
							: 'fa-solid fa-sort';
					}
				});
			}

			// Client-side pagination without page reload
			const prevBtn = document.getElementById('prev-week-btn') as HTMLAnchorElement | null;
			const nextBtn = document.getElementById('next-week-btn') as HTMLAnchorElement | null;
			const rangeLabel = document.getElementById('week-range-label');
			const weekContainers = document.querySelectorAll('.week-container');

			if (weekContainers.length > 0) {
				const weeks = Array.from(weekContainers).map(el => el.getAttribute('data-week') || '');
				let currentWeek = new URL(window.location.href).searchParams.get('week') || weeks[0] || '';

				function updatePaginationUI(selected: string, shouldPushState = true) {
					currentWeek = selected;

					weekContainers.forEach(container => {
						const week = container.getAttribute('data-week');
						if (week === selected) {
							container.classList.remove('hidden');
							if (rangeLabel) {
								rangeLabel.textContent = container.getAttribute('data-week-range') || '';
							}
						} else {
							container.classList.add('hidden');
						}
					});

					const selectedIndex = weeks.indexOf(selected);
					const hasPrev = selectedIndex !== -1 && selectedIndex < weeks.length - 1;
					const hasNext = selectedIndex > 0;

					const prevWeek = hasPrev ? weeks[selectedIndex + 1] : null;
					const nextWeek = hasNext ? weeks[selectedIndex - 1] : null;

					// Sin semana para ir, el botón queda deshabilitado (estado del sistema: gris con texto suave)
					const setWeekLink = (btn: HTMLAnchorElement | null, week: string | null) => {
						if (!btn) return;
						if (week) {
							btn.href = `?week=${week}#historial-seccion`;
							btn.removeAttribute('aria-disabled');
						} else {
							btn.removeAttribute('href');
							btn.setAttribute('aria-disabled', 'true');
						}
					};
					setWeekLink(prevBtn, prevWeek);
					setWeekLink(nextBtn, nextWeek);

					if (shouldPushState) {
						const url = new URL(window.location.href);
						url.searchParams.set('week', selected);
						url.hash = 'historial-seccion';
						window.history.pushState({ week: selected }, '', url.toString());
					}
				}

				prevBtn?.addEventListener('click', (e) => {
					e.preventDefault();
					const selectedIndex = weeks.indexOf(currentWeek);
					if (selectedIndex !== -1 && selectedIndex < weeks.length - 1) {
						updatePaginationUI(weeks[selectedIndex + 1]);
					}
				});

				nextBtn?.addEventListener('click', (e) => {
					e.preventDefault();
					const selectedIndex = weeks.indexOf(currentWeek);
					if (selectedIndex > 0) {
						updatePaginationUI(weeks[selectedIndex - 1]);
					}
				});

				// We store the handler function in popstate so it can pop cleanly
				const popStateUpdate = (e: PopStateEvent) => {
					const stateWeek = e.state?.week;
					const urlParams = new URLSearchParams(window.location.search);
					const weekFromUrl = stateWeek || urlParams.get('week') || weeks[0] || '';
					if (weekFromUrl && weeks.includes(weekFromUrl) && weekFromUrl !== currentWeek) {
						updatePaginationUI(weekFromUrl, false);
					}
				};

				window.addEventListener('popstate', popStateUpdate);
			}
		});
	</script>
</Layout>
