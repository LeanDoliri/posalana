---
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout>
    <section class="bg-lutvia-blanco p-8 md:p-14 rounded-3xl shadow-xl text-center animate-in fade-in slide-in-from-bottom-4">
        <p class="rotulo mb-6">Error 404 · Tiro inválido</p>

        <!-- El "tiro" 4 · fantasma · 4: el dado del medio no tiene cara -->
        <div id="nf-dice" class="flex items-center justify-center gap-4 sm:gap-6 text-7xl sm:text-8xl mb-8 select-none" role="img" aria-label="Tiro inválido: dos dados y un fantasma">
            <i class="fa-solid fa-dice-four text-lutvia-oscuro" data-nf-die aria-hidden="true"></i>
            <span
                class="inline-flex items-center justify-center w-[0.875em] h-[0.875em] rounded-[0.16em] bg-lutvia-rosa text-lutvia-blanco animate-float"
                title="Este dado no tiene cara"
                aria-hidden="true"
            ><i class="fa-solid fa-ghost text-[0.45em]"></i></span>
            <i class="fa-solid fa-dice-four text-lutvia-violeta" data-nf-die aria-hidden="true"></i>
        </div>

        <h2 class="text-3xl md:text-5xl font-black tracking-tight text-lutvia-oscuro text-balance">Esta página no está en la mesa</h2>
        <p class="text-lutvia-texto-suave mt-4 max-w-md mx-auto text-pretty">
            Sacaste <strong class="text-lutvia-oscuro">4, 4 y un fantasma</strong>: ese tiro no existe, y esta página tampoco.
            O el link está mal, o se fue a lavar los platos y no volvió.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="boton boton-principal w-full sm:w-auto px-8 py-3.5">
                <i class="fa-solid fa-house" aria-hidden="true"></i> Volver a la mesa
            </a>
            <button type="button" id="nf-reroll" class="boton boton-secundario w-full sm:w-auto px-8 py-3.5">
                <i class="fa-solid fa-dice" aria-hidden="true"></i> Tirar de nuevo
            </button>
        </div>
        <p id="nf-reroll-msg" class="text-xs text-lutvia-texto-suave font-medium mt-4 min-h-4" aria-live="polite"></p>
    </section>

    <script is:inline>
        (function () {
            const button = document.getElementById("nf-reroll");
            const msg = document.getElementById("nf-reroll-msg");
            const dice = document.querySelectorAll("[data-nf-die]");
            if (!button || !msg) return;

            const words = ["one", "two", "three", "four", "five", "six"];
            const quips = [
                "Por más que tires, el fantasma no se va.",
                "El destino insiste: esta página no existe.",
                "Ni la Cláusula Lomito salva este link.",
                "Tirada anulada por el admin del universo.",
            ];
            let tries = 0;

            button.addEventListener("click", () => {
                // Con movimiento reducido los dados no se sacuden ni cambian de cara: solo aparece el mensaje
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    msg.textContent = quips[tries++ % quips.length];
                    return;
                }

                button.disabled = true;
                dice.forEach((d) => d.classList.add("animate-shake-roll"));
                const spin = setInterval(() => {
                    dice.forEach((d) => {
                        words.forEach((w) => d.classList.remove(`fa-dice-${w}`));
                        d.classList.add(`fa-dice-${words[Math.floor(Math.random() * 6)]}`);
                    });
                }, 70);

                setTimeout(() => {
                    clearInterval(spin);
                    dice.forEach((d) => d.classList.remove("animate-shake-roll"));
                    msg.textContent = quips[tries++ % quips.length];
                    button.disabled = false;
                }, 900);
            });
        })();
    </script>
</Layout>
