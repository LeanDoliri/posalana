---
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout>
    <section class="relative bg-white border border-foreground/10 p-8 md:p-14 rounded-3xl shadow-xl overflow-hidden text-center animate-in fade-in slide-in-from-bottom-4 duration-500 ease-out">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-pildora blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-secondary/10 rounded-pildora blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
            <p class="text-primary font-bold tracking-widest uppercase text-xs mb-6">Error 404 · Tiro inválido</p>

            <!-- El "tiro" 4 · fantasma · 4: el dado del medio no tiene cara -->
            <div id="nf-dice" class="flex items-center justify-center gap-4 sm:gap-6 text-7xl sm:text-8xl mb-8 select-none">
                <i class="fa-solid fa-dice-four text-secondary" data-nf-die></i>
                <span
                    class="inline-flex items-center justify-center w-[0.875em] h-[0.875em] rounded-[0.16em] bg-primary text-white animate-float"
                    title="Este dado no tiene cara"
                    aria-label="Dado fantasma"
                ><i class="fa-solid fa-ghost text-[0.45em]"></i></span>
                <i class="fa-solid fa-dice-four text-accent" data-nf-die></i>
            </div>

            <h2 class="text-3xl md:text-5xl font-black tracking-tight text-foreground text-balance">Esta página no está en la mesa</h2>
            <p class="text-foreground/60 mt-4 max-w-md mx-auto text-pretty">
                Sacaste <strong class="text-foreground">4, 4 y un fantasma</strong>: ese tiro no existe, y esta página tampoco.
                O el link está mal, o se fue a lavar los platos y no volvió.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/" class="w-full sm:w-auto bg-secondary text-background font-bold px-8 py-3.5 rounded-pildora shadow-[0_8px_30px_rgba(0,204,204,0.3)] hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-house"></i> Volver a la mesa
                </a>
                <button type="button" id="nf-reroll" class="w-full sm:w-auto bg-foreground/5 hover:bg-foreground/10 text-foreground font-bold px-8 py-3.5 rounded-pildora transition-colors flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-dice"></i> Tirar de nuevo
                </button>
            </div>
            <p id="nf-reroll-msg" class="text-xs text-foreground/40 font-medium mt-4 min-h-4" aria-live="polite"></p>
        </div>
    </section>

    <script is:inline>
        (function () {
            const button = document.getElementById("nf-reroll");
            const msg = document.getElementById("nf-reroll-msg");
            const dice = document.querySelectorAll("[data-nf-die]");
            if (!button || !msg) return;

            const words = ["one", "two", "three", "four", "five", "six"];
            const quips = [
                "Por más que tires, el fantasma no se va.",
                "El destino insiste: esta página no existe.",
                "Ni la Cláusula Lomito salva este link.",
                "Tirada anulada por el admin del universo.",
            ];
            let tries = 0;

            button.addEventListener("click", () => {
                button.disabled = true;
                dice.forEach((d) => d.classList.add("animate-shake-roll"));
                const spin = setInterval(() => {
                    dice.forEach((d) => {
                        words.forEach((w) => d.classList.remove(`fa-dice-${w}`));
                        d.classList.add(`fa-dice-${words[Math.floor(Math.random() * 6)]}`);
                    });
                }, 70);

                setTimeout(() => {
                    clearInterval(spin);
                    dice.forEach((d) => d.classList.remove("animate-shake-roll"));
                    msg.textContent = quips[tries++ % quips.length];
                    button.disabled = false;
                }, 900);
            });
        })();
    </script>
</Layout>
